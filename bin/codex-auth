#!/usr/bin/env bash
set -euo pipefail

APP_VERSION="0.4.3"
CODEX_HOME="${CODEX_HOME:-$HOME/.codex}"
AUTH_FILE="$CODEX_HOME/auth.json"
ACCOUNTS_DIR="$CODEX_HOME/accounts"
PROFILES_DIR="$ACCOUNTS_DIR/profiles"
CURRENT_PROFILE_FILE="$ACCOUNTS_DIR/current_profile"
SESSIONS_DIR="${CODEX_AUTH_SESSIONS_DIR:-$CODEX_HOME/sessions}"
DEFAULT_USAGE_URL="https://chatgpt.com/backend-api/codex/usage"
FALLBACK_USAGE_URL="https://chatgpt.com/backend-api/wham/usage"
DEFAULT_INSTALL_FROM_BASE="https://raw.githubusercontent.com/Fasand/codex-auth/main"
export CODEX_AUTH_THEME_HEADER_STYLE="${CODEX_AUTH_THEME_HEADER_STYLE:-1}"
export CODEX_AUTH_THEME_ACTIVE_STYLE="${CODEX_AUTH_THEME_ACTIVE_STYLE:-1;93}"
export CODEX_AUTH_THEME_PROFILE_STYLE="${CODEX_AUTH_THEME_PROFILE_STYLE:-36}"
export CODEX_AUTH_THEME_RESET_STYLE="${CODEX_AUTH_THEME_RESET_STYLE:-34}"
export CODEX_AUTH_THEME_DIM_STYLE="${CODEX_AUTH_THEME_DIM_STYLE:-2}"
export CODEX_AUTH_THEME_PLAN_STYLE="${CODEX_AUTH_THEME_PLAN_STYLE:-35}"
export CODEX_AUTH_THEME_PERCENT_OK_STYLE="${CODEX_AUTH_THEME_PERCENT_OK_STYLE:-32}"
export CODEX_AUTH_THEME_PERCENT_WARN_STYLE="${CODEX_AUTH_THEME_PERCENT_WARN_STYLE:-33}"
export CODEX_AUTH_THEME_PERCENT_BAD_STYLE="${CODEX_AUTH_THEME_PERCENT_BAD_STYLE:-31}"

usage() {
  cat <<USAGE
Usage: codex-auth <command> [args]

Manage multiple ChatGPT Codex auth.json profiles.

Commands:
  list [--utc]              List saved profiles with account info and cached usage
  current [--utc]           Show the currently active auth profile or current auth summary
  save <name>               Save the current auth.json as a named profile
  switch [name]             Switch to a saved profile (interactive if name omitted)
  add <name>                Run codex login, then save the result as <name>
  refresh-usage [--utc] [<name>|--all]
                            Query live usage for one profile or, with no args, confirm refresh for all profiles
  refresh [--utc] [<name>|--all]
                            Alias for refresh-usage
  update                    Update this installed codex-auth via install.sh
  rename <old> <new>        Rename a saved profile
  remove <name>             Delete a saved profile snapshot
  version                   Show the codex-auth version
  help                      Show this help

Environment:
  CODEX_HOME                Override Codex home (default: ~/.codex)
  CODEX_AUTH_INSTALL_FROM   Override installer source for self-update/advanced installs
  CODEX_AUTH_USAGE_URL      Override usage endpoint URL for testing/custom routing
  CODEX_AUTH_SESSIONS_DIR   Override sessions directory for session snapshot parsing
USAGE
}

print_version() {
  printf '%s\n' "$APP_VERSION"
}

die() {
  echo "codex-auth: $*" >&2
  exit 1
}

note() {
  echo "$*" >&2
}

have_cmd() {
  command -v "$1" >/dev/null 2>&1
}

require_cmd() {
  have_cmd "$1" || die "Required command not found: $1"
}

color_output_enabled() {
  [[ "${CODEX_AUTH_FORCE_COLOR:-0}" == "1" ]] && return 0
  [[ -n "${NO_COLOR:-}" ]] && return 1
  [[ "${TERM:-}" == "dumb" ]] && return 1
  [[ -t 1 ]]
}

ensure_dirs() {
  mkdir -p "$PROFILES_DIR"
}

require_auth_file() {
  [[ -f "$AUTH_FILE" ]] || die "No auth.json found at $AUTH_FILE"
}

validate_profile_name() {
  local name=${1:-}
  [[ -n "$name" ]] || die "Profile name is required"
  [[ "$name" =~ ^[A-Za-z0-9._-]+$ ]] || die "Invalid profile name '$name' (allowed: letters, numbers, dot, underscore, hyphen)"
}

profile_dir() {
  printf '%s\n' "$PROFILES_DIR/$1"
}

profile_auth_path() {
  printf '%s/auth.json\n' "$(profile_dir "$1")"
}

profile_meta_path() {
  printf '%s/meta.json\n' "$(profile_dir "$1")"
}

profile_usage_path() {
  printf '%s/usage.json\n' "$(profile_dir "$1")"
}

list_profile_names() {
  ensure_dirs
  local dir
  for dir in "$PROFILES_DIR"/*; do
    [[ -d "$dir" ]] || continue
    basename "$dir"
  done | sort
}

find_matching_profile() {
  [[ -f "$AUTH_FILE" ]] || return 1
  local name path
  while IFS= read -r name; do
    path=$(profile_auth_path "$name")
    [[ -f "$path" ]] || continue
    if cmp -s "$AUTH_FILE" "$path"; then
      printf '%s\n' "$name"
      return 0
    fi
  done < <(list_profile_names)
  return 1
}

write_current_profile_marker() {
  ensure_dirs
  printf '%s\n' "$1" > "$CURRENT_PROFILE_FILE"
}

clear_current_profile_marker_if_matches() {
  local name=${1:-}
  if [[ -f "$CURRENT_PROFILE_FILE" ]] && [[ "$(cat "$CURRENT_PROFILE_FILE")" == "$name" ]]; then
    rm -f "$CURRENT_PROFILE_FILE"
  fi
}

extract_meta_json() {
  local profile_name=$1
  local auth_path=$2
  python3 - "$profile_name" "$auth_path" <<'PY'
import base64
import datetime as dt
import json
import sys
from pathlib import Path

profile_name, auth_path = sys.argv[1:3]
obj = json.loads(Path(auth_path).read_text())
tokens = obj.get('tokens') or {}
id_token = tokens.get('id_token') or ''
claims = {}
if isinstance(id_token, str) and '.' in id_token:
    parts = id_token.split('.')
    if len(parts) >= 2 and parts[1]:
        payload = parts[1] + '=' * (-len(parts[1]) % 4)
        try:
            claims = json.loads(base64.urlsafe_b64decode(payload.encode()).decode())
        except Exception:
            claims = {}

def iso_from_epoch(value):
    if value is None:
        return None
    try:
        return dt.datetime.fromtimestamp(int(value), tz=dt.timezone.utc).strftime('%Y-%m-%dT%H:%M:%SZ')
    except Exception:
        return None

meta = {
    'profileName': profile_name,
    'savedAt': dt.datetime.now(dt.timezone.utc).strftime('%Y-%m-%dT%H:%M:%SZ'),
    'email': claims.get('email'),
    'emailVerified': claims.get('email_verified'),
    'subject': claims.get('sub'),
    'accountId': tokens.get('account_id'),
    'lastRefresh': obj.get('last_refresh'),
    'tokenExpiresAt': iso_from_epoch(claims.get('exp')),
    'tokenExpiresEpoch': claims.get('exp'),
    'authProvider': claims.get('auth_provider'),
}
print(json.dumps(meta, indent=2, sort_keys=True))
PY
}

write_meta_file() {
  local profile_name=$1
  local auth_path=$2
  local meta_path=$3
  extract_meta_json "$profile_name" "$auth_path" > "$meta_path"
}

latest_session_snapshot_json() {
  local sessions_dir=$1
  python3 - "$sessions_dir" <<'PY'
import json
import math
import sys
from pathlib import Path

sessions_dir = Path(sys.argv[1])
if not sessions_dir.exists():
    raise SystemExit(1)

files = sorted(sessions_dir.glob('**/rollout-*.jsonl'), key=lambda p: p.stat().st_mtime, reverse=True)
for path in files:
    try:
        lines = path.read_text(encoding='utf-8', errors='replace').splitlines()
    except Exception:
        continue
    for line in reversed(lines):
        try:
            obj = json.loads(line)
        except Exception:
            continue
        payload = obj.get('payload') if obj.get('type') == 'event_msg' else None
        if not isinstance(payload, dict) or payload.get('type') != 'token_count':
            continue
        info = payload.get('info') or {}
        last_usage = info.get('last_token_usage') or {}
        model_context_window = info.get('model_context_window')
        total = last_usage.get('total_tokens')
        if not model_context_window or total is None:
            continue
        try:
            context_used = int(round((float(total) / float(model_context_window)) * 100))
        except Exception:
            context_used = None
        rate_limits = payload.get('rate_limits') or {}
        primary = rate_limits.get('primary') or {}
        secondary = rate_limits.get('secondary') or {}
        snapshot = {
            'source': 'session',
            'capturedAt': obj.get('timestamp'),
            'rolloutPath': str(path),
            'context_used_percent': context_used,
            'effective_context_window': int(model_context_window),
            'five_hour_used_percent': None if primary.get('used_percent') is None else int(round(float(primary.get('used_percent')))),
            'weekly_used_percent': None if secondary.get('used_percent') is None else int(round(float(secondary.get('used_percent')))),
            'five_hour_reset_at': primary.get('resets_at'),
            'weekly_reset_at': secondary.get('resets_at'),
            'plan_type': rate_limits.get('plan_type'),
        }
        if snapshot['five_hour_used_percent'] is not None:
            snapshot['five_hour_remaining_percent'] = max(0, 100 - snapshot['five_hour_used_percent'])
        if snapshot['weekly_used_percent'] is not None:
            snapshot['weekly_remaining_percent'] = max(0, 100 - snapshot['weekly_used_percent'])
        print(json.dumps(snapshot))
        raise SystemExit(0)
raise SystemExit(1)
PY
}

refresh_usage_python() {
  local auth_path=$1
  local usage_path=$2
  local include_session=${3:-0}
  local session_json=${4:-}
  local profile_name=${5:-}
  python3 - "$auth_path" "$usage_path" "$DEFAULT_USAGE_URL" "$FALLBACK_USAGE_URL" "$include_session" "$session_json" "$profile_name" "$APP_VERSION" <<'PY'
import datetime as dt
import json
import os
import sys
import urllib.error
import urllib.request
from pathlib import Path

auth_path, usage_path, default_url, fallback_url, include_session, session_json, profile_name, app_version = sys.argv[1:9]
obj = json.loads(Path(auth_path).read_text())
tokens = obj.get('tokens') or {}
access_token = tokens.get('access_token')
account_id = tokens.get('account_id')
if not access_token or not account_id:
    raise SystemExit('Missing access_token or account_id in auth snapshot')


def derived_from_backend(data):
    rate = data.get('rate_limit') or {}
    primary = rate.get('primary_window') or {}
    secondary = rate.get('secondary_window') or {}
    derived = {
        'five_hour_used_percent': primary.get('used_percent'),
        'weekly_used_percent': secondary.get('used_percent'),
        'five_hour_remaining_percent': None,
        'weekly_remaining_percent': None,
        'five_hour_reset_at': primary.get('reset_at'),
        'weekly_reset_at': secondary.get('reset_at'),
        'five_hour_reset_after_seconds': primary.get('reset_after_seconds'),
        'weekly_reset_after_seconds': secondary.get('reset_after_seconds'),
    }
    if primary.get('used_percent') is not None:
        derived['five_hour_remaining_percent'] = max(0, 100 - int(round(float(primary.get('used_percent')))))
    if secondary.get('used_percent') is not None:
        derived['weekly_remaining_percent'] = max(0, 100 - int(round(float(secondary.get('used_percent')))))
    return derived


def make_error_message(message, *, code=None):
    prefix = f"Unable to refresh usage for '{profile_name}':" if profile_name else "Unable to refresh usage:"
    parts = [prefix]
    if code:
        parts.append(f"{code}:")
    parts.append(message)
    return ' '.join(parts)


def auth_relogin_message(message, *, code=None):
    command = "codex logout && codex login && codex-auth save <profile>"
    if profile_name:
        command = f"codex-auth switch {profile_name} && codex logout && codex login && codex-auth save {profile_name}"
    return make_error_message(
        f"{message} This profile needs to be logged in again. Run: {command}",
        code=code,
    )


def parse_error_payload(raw):
    try:
        payload = json.loads(raw)
    except Exception:
        return None
    if not isinstance(payload, dict):
        return None
    error = payload.get('error')
    if not isinstance(error, dict):
        return None
    return {
        'code': error.get('code'),
        'message': error.get('message'),
        'status': payload.get('status'),
    }

urls = []
custom_url = os.environ.get('CODEX_AUTH_USAGE_URL')
if custom_url:
    urls.append(custom_url)
else:
    urls.extend([default_url, fallback_url])

last_error = None
for url in urls:
    req = urllib.request.Request(
        url,
        headers={
            'Authorization': f'Bearer {access_token}',
            'ChatGPT-Account-Id': account_id,
            'Accept': 'application/json',
            'User-Agent': f'codex-auth/{app_version}',
        },
    )
    try:
        with urllib.request.urlopen(req, timeout=20) as resp:
            raw = resp.read().decode('utf-8', 'replace')
            data = json.loads(raw)
            payload = {
                'fetchedAt': dt.datetime.now(dt.timezone.utc).strftime('%Y-%m-%dT%H:%M:%SZ'),
                'source': 'live',
                'url': url,
            }
            payload.update(data)
            payload['backend_derived'] = derived_from_backend(payload)
            payload['derived'] = dict(payload['backend_derived'])
            if include_session == '1' and session_json:
                try:
                    payload['session'] = json.loads(session_json)
                    for key in (
                        'five_hour_used_percent',
                        'weekly_used_percent',
                        'five_hour_remaining_percent',
                        'weekly_remaining_percent',
                        'five_hour_reset_at',
                        'weekly_reset_at',
                    ):
                        if payload['derived'].get(key) is None:
                            value = payload['session'].get(key)
                            if value is not None:
                                payload['derived'][key] = value
                except Exception:
                    pass
            Path(usage_path).write_text(json.dumps(payload, indent=2, sort_keys=True), encoding='utf-8')
            print(json.dumps(payload))
            raise SystemExit(0)
    except urllib.error.HTTPError as exc:
        body = exc.read().decode('utf-8', 'replace')
        parsed = parse_error_payload(body)
        error_code = parsed.get('code') if parsed else None
        error_message = parsed.get('message') if parsed and parsed.get('message') else str(exc)
        if exc.code == 401:
            lower_message = error_message.lower()
            if (
                error_code == 'token_expired'
                or 'expired' in lower_message
                or 'sign in again' in lower_message
                or 'signing in again' in lower_message
            ):
                raise SystemExit(auth_relogin_message(error_message, code=error_code or '401'))
            raise SystemExit(make_error_message(error_message, code=error_code or '401'))
        if parsed and error_message:
            last_error = make_error_message(error_message, code=error_code or exc.code)
        else:
            last_error = make_error_message(str(exc))
    except Exception as exc:
        last_error = make_error_message(str(exc))

raise SystemExit(last_error)
PY
}

profile_display_payload_json() {
  local profile_name=$1
  local meta_path=$2
  local usage_path=$3
  local active_name=${4:-}
  local use_utc=${5:-0}
  python3 - "$profile_name" "$meta_path" "$usage_path" "$active_name" "$use_utc" <<'PY'
import datetime as dt
import json
import sys
from pathlib import Path

profile_name, meta_path, usage_path, active_name, use_utc = sys.argv[1:6]
meta = json.loads(Path(meta_path).read_text()) if Path(meta_path).exists() else {}
usage = json.loads(Path(usage_path).read_text()) if Path(usage_path).exists() else {}
derived = usage.get('derived') or {}
session = usage.get('session') or {}
is_active = profile_name == active_name
local_tz = dt.datetime.now().astimezone().tzinfo or dt.timezone.utc


def first_value(*values):
    for value in values:
        if value not in (None, '', [], {}):
            return value
    return None


def parse_datetime(value):
    if value in (None, '', [], {}):
        return None
    if isinstance(value, (int, float)):
        return dt.datetime.fromtimestamp(float(value), tz=dt.timezone.utc)
    text = str(value).strip()
    if not text:
        return None
    if text.isdigit():
        return dt.datetime.fromtimestamp(int(text), tz=dt.timezone.utc)
    normalized = text[:-1] + '+00:00' if text.endswith('Z') else text
    try:
        parsed = dt.datetime.fromisoformat(normalized)
    except ValueError:
        return None
    if parsed.tzinfo is None:
        parsed = parsed.replace(tzinfo=dt.timezone.utc)
    return parsed


def format_datetime(value):
    parsed = parse_datetime(value)
    if parsed is None:
        return ''
    if use_utc == '1':
        return parsed.astimezone(dt.timezone.utc).strftime('%Y-%m-%d %H:%MZ')
    localized = parsed.astimezone(local_tz)
    tz_name = localized.tzname() or 'UTC'
    return localized.strftime('%d %b %H:%M ') + tz_name


def format_percent(value):
    if value in (None, ''):
        return ''
    try:
        return f"{int(round(float(value)))}%"
    except Exception:
        return str(value)


payload = {
    'active': is_active,
    'profile': profile_name,
    'email': meta.get('email') or '',
    'account': meta.get('accountId') or '',
    'plan': first_value(usage.get('plan_type'), session.get('plan_type')) or '',
    'five_hour': format_percent(first_value(derived.get('five_hour_remaining_percent'), session.get('five_hour_remaining_percent'))),
    'five_hour_reset': format_datetime(first_value(derived.get('five_hour_reset_at'), session.get('five_hour_reset_at'))),
    'weekly': format_percent(first_value(derived.get('weekly_remaining_percent'), session.get('weekly_remaining_percent'))),
    'weekly_reset': format_datetime(first_value(derived.get('weekly_reset_at'), session.get('weekly_reset_at'))),
    'checked': format_datetime(usage.get('fetchedAt')),
    'token_expires': format_datetime(meta.get('tokenExpiresAt')),
    'last_refresh': format_datetime(meta.get('lastRefresh')),
}
print(json.dumps(payload))
PY
}

render_profile_line() {
  local profile_name=$1
  local active_name=${2:-}
  local use_utc=${3:-0}
  local meta_path usage_path
  local payload_json
  meta_path=$(profile_meta_path "$profile_name")
  usage_path=$(profile_usage_path "$profile_name")
  payload_json=$(profile_display_payload_json "$profile_name" "$meta_path" "$usage_path" "$active_name" "$use_utc")
  python3 - "$payload_json" <<'PY'
import json
import os
import re
import sys

payload = json.loads(sys.argv[1])


def use_color():
    if os.environ.get('CODEX_AUTH_FORCE_COLOR') == '1':
        return True
    if os.environ.get('NO_COLOR'):
        return False
    if os.environ.get('TERM') == 'dumb':
        return False
    return sys.stdout.isatty()


def paint(text, style_name):
    if not text:
        return text
    if not use_color():
        return text
    style = os.environ.get(style_name, '')
    return f"\033[{style}m{text}\033[0m" if style else text


def percent_style(value):
    match = re.search(r'(\d+)', value or '')
    if not match:
        return value
    amount = int(match.group(1))
    if amount >= 67:
        return paint(value, 'CODEX_AUTH_THEME_PERCENT_OK_STYLE')
    if amount >= 34:
        return paint(value, 'CODEX_AUTH_THEME_PERCENT_WARN_STYLE')
    return paint(value, 'CODEX_AUTH_THEME_PERCENT_BAD_STYLE')


parts = []
marker = paint('*', 'CODEX_AUTH_THEME_ACTIVE_STYLE') if payload.get('active') else '-'
parts.append(f"{marker} {paint(payload.get('profile') or 'unknown-profile', 'CODEX_AUTH_THEME_PROFILE_STYLE')}")
if payload.get('email'):
    parts.append(payload['email'])
if payload.get('account'):
    parts.append(f"account={payload['account']}")
if payload.get('plan'):
    parts.append(f"plan={paint(payload['plan'], 'CODEX_AUTH_THEME_PLAN_STYLE')}")
if payload.get('five_hour'):
    segment = f"5h {percent_style(payload['five_hour'])}"
    if payload.get('five_hour_reset'):
        segment += f" (resets {paint(payload['five_hour_reset'], 'CODEX_AUTH_THEME_RESET_STYLE')})"
    parts.append(segment)
if payload.get('weekly'):
    segment = f"weekly {percent_style(payload['weekly'])}"
    if payload.get('weekly_reset'):
        segment += f" (resets {paint(payload['weekly_reset'], 'CODEX_AUTH_THEME_RESET_STYLE')})"
    parts.append(segment)
if payload.get('checked'):
    parts.append(f"checked={paint(payload['checked'], 'CODEX_AUTH_THEME_DIM_STYLE')}")
print(' | '.join(parts))
PY
}


profile_switch_row_tsv() {
  local profile_name=$1
  local active_name=${2:-}
  local meta_path usage_path
  meta_path=$(profile_meta_path "$profile_name")
  usage_path=$(profile_usage_path "$profile_name")
  python3 - "$profile_name" "$meta_path" "$usage_path" "$active_name" <<'PY'
import json
import sys
from pathlib import Path

profile_name, meta_path, usage_path, active_name = sys.argv[1:5]
meta = json.loads(Path(meta_path).read_text()) if Path(meta_path).exists() else {}
usage = json.loads(Path(usage_path).read_text()) if Path(usage_path).exists() else {}
derived = usage.get('derived') or {}
is_active = profile_name == active_name

def ellipsize(value, width):
    value = '' if value is None else str(value)
    if len(value) <= width:
        return value.ljust(width)
    if width <= 1:
        return value[:width]
    return value[:width - 1] + '…'

def pct(value):
    if value in (None, ''):
        return '  -'
    try:
        return f"{int(round(float(value))):>3}%"
    except Exception:
        return str(value).rjust(4)

active = '*' if is_active else ' '
profile_col = ellipsize(profile_name, 24)
email_col = ellipsize(meta.get('email') or '', 32)
fiveh_col = pct(derived.get('five_hour_remaining_percent'))
weekly_col = pct(derived.get('weekly_remaining_percent'))
display = f"{active} {profile_col}  {email_col}  5h {fiveh_col}  wk {weekly_col}"
print(f"{profile_name}	{display}")
PY
}

refresh_usage_for_profile() {
  local profile_name=$1
  validate_profile_name "$profile_name"
  local dir auth_path usage_path include_session=0 session_json="" error_file output status
  dir=$(profile_dir "$profile_name")
  [[ -d "$dir" ]] || die "Unknown profile '$profile_name'"
  auth_path=$(profile_auth_path "$profile_name")
  usage_path=$(profile_usage_path "$profile_name")
  if [[ -f "$AUTH_FILE" ]] && cmp -s "$AUTH_FILE" "$auth_path"; then
    if session_json=$(latest_session_snapshot_json "$SESSIONS_DIR" 2>/dev/null); then
      include_session=1
    fi
  fi
  error_file=$(mktemp)
  if refresh_usage_python "$auth_path" "$usage_path" "$include_session" "$session_json" "$profile_name" >/dev/null 2>"$error_file"; then
    rm -f "$error_file"
    return 0
  else
    status=$?
  fi
  output=$(cat "$error_file")
  rm -f "$error_file"
  output=${output//$'\n'/ }
  printf '%s\n' "$output"
  return "$status"
}

best_effort_refresh_usage() {
  local profile_name=$1
  refresh_usage_for_profile "$profile_name" >/dev/null 2>&1 || true
}

refresh_progress_bar() {
  local completed=$1
  local total=$2
  local width=${3:-12}
  local filled=0 empty=0 i
  (( total > 0 )) || total=1
  (( completed < 0 )) && completed=0
  (( completed > total )) && completed=$total
  filled=$(( completed * width / total ))
  empty=$(( width - filled ))
  printf '['
  for ((i = 0; i < filled; i++)); do
    printf '#'
  done
  for ((i = 0; i < empty; i++)); do
    printf '.'
  done
  printf ']'
}

refresh_progress_begin() {
  local index=$1
  local total=$2
  local profile_name=$3
  if [[ -t 2 ]]; then
    printf '\rRefreshing %d/%d %s %s...\033[K' "$index" "$total" "$(refresh_progress_bar "$((index - 1))" "$total")" "$profile_name" >&2
  else
    printf 'Refreshing %d/%d: %s... ' "$index" "$total" "$profile_name" >&2
  fi
}

refresh_progress_finish() {
  local index=$1
  local total=$2
  local profile_name=$3
  local outcome=$4
  local detail=${5:-}
  if [[ -t 2 ]]; then
    if [[ "$outcome" == "ok" ]]; then
      printf '\rRefreshed  %d/%d %s %s\033[K' "$index" "$total" "$(refresh_progress_bar "$index" "$total")" "$profile_name" >&2
    else
      printf '\rFailed     %d/%d %s %s — see summary below\033[K' "$index" "$total" "$(refresh_progress_bar "$index" "$total")" "$profile_name" >&2
    fi
    return 0
  fi

  if [[ "$outcome" == "ok" ]]; then
    note "Refreshed $profile_name"
  else
    note "Failed $profile_name: $detail"
  fi
}

refresh_progress_clear() {
  [[ -t 2 ]] || return 0
  printf '\r\033[K' >&2
}

collect_refresh_targets() {
  local target=${1:-}
  local name
  if [[ "$target" == "--all" ]]; then
    while IFS= read -r name; do
      [[ -n "$name" ]] || continue
      printf '%s\n' "$name"
    done < <(list_profile_names)
    return 0
  fi

  validate_profile_name "$target"
  [[ -d "$(profile_dir "$target")" ]] || die "Unknown profile '$target'"
  printf '%s\n' "$target"
}

render_profile_table() {
  local payload_file=$1
  local color_enabled=0
  if color_output_enabled; then
    color_enabled=1
  fi

  python3 - "$payload_file" "$color_enabled" <<'PY'
import json
import os
import re
import sys
from pathlib import Path

rows = []
for line in Path(sys.argv[1]).read_text(encoding='utf-8').splitlines():
    line = line.strip()
    if line:
        rows.append(json.loads(line))

if not rows:
    raise SystemExit(0)

color_enabled = sys.argv[2] == '1'


def paint(text, style_name):
    if not text or not color_enabled:
        return text
    style = os.environ.get(style_name, '')
    return f"\033[{style}m{text}\033[0m" if style else text


def percent_style(value):
    match = re.search(r'(\d+)', value or '')
    if not match:
        return value
    amount = int(match.group(1))
    if amount >= 67:
        return paint(value, 'CODEX_AUTH_THEME_PERCENT_OK_STYLE')
    if amount >= 34:
        return paint(value, 'CODEX_AUTH_THEME_PERCENT_WARN_STYLE')
    return paint(value, 'CODEX_AUTH_THEME_PERCENT_BAD_STYLE')


def profile_cell(row):
    marker = paint('*', 'CODEX_AUTH_THEME_ACTIVE_STYLE') if row.get('active') else ' '
    profile = paint(row.get('profile') or '', 'CODEX_AUTH_THEME_PROFILE_STYLE')
    return f"{marker} {profile}"


profile_plain_cells = [("* " if row.get('active') else "  ") + (row.get('profile') or '') for row in rows]
headers = ['PROFILE', 'EMAIL', 'PLAN', '5H', 'RESET', 'WEEKLY', 'RESET', 'CHECKED']
columns = [
    profile_plain_cells,
    [row.get('email') or '' for row in rows],
    [row.get('plan') or '' for row in rows],
    [row.get('five_hour') or '' for row in rows],
    [row.get('five_hour_reset') or '' for row in rows],
    [row.get('weekly') or '' for row in rows],
    [row.get('weekly_reset') or '' for row in rows],
    [row.get('checked') or '' for row in rows],
]
widths = []
for header, values in zip(headers, columns):
    widths.append(max([len(header)] + [len(value) for value in values]))


def pad(value, width):
    return (value or '').ljust(width)


def render_row(index, header=False):
    row = rows[index] if not header else None
    values = [
        headers[0] if header else pad(profile_plain_cells[index], widths[0]),
        headers[1] if header else pad(row.get('email') or '', widths[1]),
        headers[2] if header else pad(row.get('plan') or '', widths[2]),
        headers[3] if header else pad(row.get('five_hour') or '', widths[3]),
        headers[4] if header else pad(row.get('five_hour_reset') or '', widths[4]),
        headers[5] if header else pad(row.get('weekly') or '', widths[5]),
        headers[6] if header else pad(row.get('weekly_reset') or '', widths[6]),
        headers[7] if header else pad(row.get('checked') or '', widths[7]),
    ]
    if header:
        values = [pad(value, width) for value, width in zip(values, widths)]
        values = [paint(value, 'CODEX_AUTH_THEME_HEADER_STYLE') for value in values]
    else:
        values[0] = profile_cell(row) + (' ' * max(0, widths[0] - len(profile_plain_cells[index])))
        if row.get('plan'):
            values[2] = paint(pad(row.get('plan') or '', widths[2]), 'CODEX_AUTH_THEME_PLAN_STYLE')
        if row.get('five_hour'):
            values[3] = percent_style(pad(row.get('five_hour') or '', widths[3]))
        if row.get('five_hour_reset'):
            values[4] = paint(pad(row.get('five_hour_reset') or '', widths[4]), 'CODEX_AUTH_THEME_RESET_STYLE')
        if row.get('weekly'):
            values[5] = percent_style(pad(row.get('weekly') or '', widths[5]))
        if row.get('weekly_reset'):
            values[6] = paint(pad(row.get('weekly_reset') or '', widths[6]), 'CODEX_AUTH_THEME_RESET_STYLE')
        if row.get('checked'):
            values[7] = paint(pad(row.get('checked') or '', widths[7]), 'CODEX_AUTH_THEME_DIM_STYLE')
    return f"{values[0]}  {values[1]}  {values[2]} | {values[3]}  {values[4]} | {values[5]}  {values[6]} | {values[7]}".rstrip()


print(render_row(0, header=True))
for index in range(len(rows)):
    print(render_row(index))
PY
}

save_profile() {
  local profile_name=$1
  validate_profile_name "$profile_name"
  require_auth_file
  ensure_dirs
  local dir auth_copy meta_path
  dir=$(profile_dir "$profile_name")
  mkdir -p "$dir"
  auth_copy="$dir/auth.json"
  meta_path="$dir/meta.json"
  cp "$AUTH_FILE" "$auth_copy"
  write_meta_file "$profile_name" "$auth_copy" "$meta_path"
  write_current_profile_marker "$profile_name"
  best_effort_refresh_usage "$profile_name"
  note "Saved profile '$profile_name'"
}

list_profiles() {
  ensure_dirs
  local use_utc=${1:-0}
  local active_name names_found=0 name payload_file
  active_name=$(find_matching_profile || true)
  payload_file=$(mktemp)
  while IFS= read -r name; do
    [[ -n "$name" ]] || continue
    names_found=1
    profile_display_payload_json "$name" "$(profile_meta_path "$name")" "$(profile_usage_path "$name")" "$active_name" "$use_utc" >> "$payload_file"
  done < <(list_profile_names)
  if [[ $names_found -eq 1 ]]; then
    render_profile_table "$payload_file"
  else
    note "No saved profiles in $PROFILES_DIR"
  fi
  rm -f "$payload_file"
}

show_current() {
  ensure_dirs
  require_auth_file
  local use_utc=${1:-0}
  local matched
  matched=$(find_matching_profile || true)
  if [[ -n "$matched" ]]; then
    render_profile_line "$matched" "$matched" "$use_utc"
    return 0
  fi

  local tmp_meta
  tmp_meta=$(mktemp)
  extract_meta_json "untracked" "$AUTH_FILE" > "$tmp_meta"
  python3 - "$tmp_meta" "$use_utc" <<'PY'
import datetime as dt
import json
import sys

meta = json.load(open(sys.argv[1]))
use_utc = sys.argv[2] == '1'
local_tz = dt.datetime.now().astimezone().tzinfo or dt.timezone.utc


def format_datetime(value):
    if not value:
        return None
    text = str(value).strip()
    if text.endswith('Z'):
        text = text[:-1] + '+00:00'
    try:
        parsed = dt.datetime.fromisoformat(text)
    except ValueError:
        return value
    if parsed.tzinfo is None:
        parsed = parsed.replace(tzinfo=dt.timezone.utc)
    if use_utc:
        return parsed.astimezone(dt.timezone.utc).strftime('%Y-%m-%d %H:%MZ')
    localized = parsed.astimezone(local_tz)
    return localized.strftime('%d %b %H:%M ') + (localized.tzname() or 'UTC')

parts = ['* untracked']
parts.append(meta.get('email') or 'unknown-email')
parts.append(f"account={meta.get('accountId') or 'unknown-account'}")
if meta.get('tokenExpiresAt'):
    parts.append(f"expires={format_datetime(meta['tokenExpiresAt'])}")
if meta.get('lastRefresh'):
    parts.append(f"last_refresh={format_datetime(meta['lastRefresh'])}")
print(' | '.join(parts))
PY
  rm -f "$tmp_meta"
}

choose_profile_interactive() {
  local active_name=${1:-}
  local entries_file use_fzf=0 name
  entries_file=$(mktemp)
  printf $'PROFILE\t  PROFILE                   EMAIL                             5H      WEEKLY\n' > "$entries_file"
  while IFS= read -r name; do
    [[ -n "$name" ]] || continue
    profile_switch_row_tsv "$name" "$active_name" >> "$entries_file"
  done < <(list_profile_names)
  [[ $(wc -l < "$entries_file") -gt 1 ]] || die "No saved profiles to select"

  if command -v fzf >/dev/null 2>&1; then
    if [[ "${CODEX_AUTH_FORCE_FZF:-0}" == "1" ]] || [[ -t 0 ]] || [[ -r /dev/tty ]]; then
      use_fzf=1
    fi
  fi

  if [[ $use_fzf -eq 1 ]]; then
    local selected
    local -a fzf_opts
    fzf_opts=(--delimiter=$'\t' --with-nth=2 --header-lines=1 --prompt='Switch to profile> ' --layout=reverse --border)
    if [[ -n "${CODEX_AUTH_FZF_FILTER:-}" ]]; then
      fzf_opts+=(--filter="$CODEX_AUTH_FZF_FILTER")
    fi
    if [[ -n "${TMUX:-}" ]] && ( [[ -t 0 ]] || [[ -r /dev/tty ]] ) && command -v fzf-tmux >/dev/null 2>&1; then
      selected=$(fzf-tmux -p 80%,70% "${fzf_opts[@]}" < "$entries_file" || true)
    else
      fzf_opts+=(--height=80%)
      selected=$(fzf "${fzf_opts[@]}" < "$entries_file" || true)
    fi
    [[ -n "$selected" ]] || die "No profile selected"
    rm -f "$entries_file"
    printf '%s\n' "$selected" | cut -f1
    return 0
  fi

  local options=() i=1 choice display profile
  echo "Select a profile:" >&2
  while IFS=$'\t' read -r profile display; do
    [[ "$profile" == "PROFILE" ]] && continue
    options+=("$profile")
    printf '  %d) %s\n' "$i" "$display" >&2
    i=$((i + 1))
  done < "$entries_file"
  read -r -p 'Enter number: ' choice
  [[ "$choice" =~ ^[0-9]+$ ]] || die "Invalid selection"
  (( choice >= 1 && choice <= ${#options[@]} )) || die "Selection out of range"
  rm -f "$entries_file"
  printf '%s\n' "${options[choice-1]}"
}

switch_profile() {
  ensure_dirs
  local target=${1:-}
  local active_name
  active_name=$(find_matching_profile || true)
  if [[ -z "$target" ]]; then
    target=$(choose_profile_interactive "$active_name")
  fi
  validate_profile_name "$target"
  local dir src
  dir=$(profile_dir "$target")
  [[ -d "$dir" ]] || die "Unknown profile '$target'"
  src="$dir/auth.json"
  [[ -f "$src" ]] || die "Profile '$target' is missing auth.json"
  cp "$src" "$AUTH_FILE"
  write_current_profile_marker "$target"
  note "Switched to '$target'"
  render_profile_line "$target" "$target"
}

add_profile() {
  local profile_name=$1
  validate_profile_name "$profile_name"
  ensure_dirs
  note "Starting codex login for profile '$profile_name'..."
  codex login
  codex login status >/dev/null 2>&1 || die "codex login did not complete successfully"
  require_auth_file
  save_profile "$profile_name"
  render_profile_line "$profile_name" "$profile_name"
}

rename_profile() {
  local old_name=$1
  local new_name=$2
  validate_profile_name "$old_name"
  validate_profile_name "$new_name"
  local old_dir new_dir
  old_dir=$(profile_dir "$old_name")
  new_dir=$(profile_dir "$new_name")
  [[ -d "$old_dir" ]] || die "Unknown profile '$old_name'"
  [[ ! -e "$new_dir" ]] || die "Profile '$new_name' already exists"
  mv "$old_dir" "$new_dir"
  if [[ -f "$CURRENT_PROFILE_FILE" ]] && [[ "$(cat "$CURRENT_PROFILE_FILE")" == "$old_name" ]]; then
    write_current_profile_marker "$new_name"
  fi
  local auth_path meta_path
  auth_path=$(profile_auth_path "$new_name")
  meta_path=$(profile_meta_path "$new_name")
  [[ -f "$auth_path" ]] && write_meta_file "$new_name" "$auth_path" "$meta_path"
  note "Renamed '$old_name' to '$new_name'"
}

remove_profile() {
  local profile_name=$1
  validate_profile_name "$profile_name"
  local dir
  dir=$(profile_dir "$profile_name")
  [[ -d "$dir" ]] || die "Unknown profile '$profile_name'"
  rm -rf "$dir"
  clear_current_profile_marker_if_matches "$profile_name"
  note "Removed '$profile_name'"
}

refresh_cancel_instruction() {
  note "Use 'codex-auth refresh-usage <profile>' for one profile or 'codex-auth refresh-usage --all' to skip the prompt."
}

confirm_refresh_all_profiles() {
  local reply
  local read_status=0
  printf 'Do you want to refresh usage for all profiles? [Y/n] ' >&2
  read -r reply || read_status=$?
  if [[ $read_status -ne 0 ]]; then
    [[ $read_status -eq 130 ]] && return 130
    note "Refresh cancelled."
    refresh_cancel_instruction
    return 1
  fi
  case "$reply" in
    ""|y|Y|yes|YES|Yes)
      return 0
      ;;
    n|N|no|NO|No)
      note "Refresh cancelled."
      refresh_cancel_instruction
      return 1
      ;;
    *)
      note "Refresh cancelled."
      refresh_cancel_instruction
      return 1
      ;;
  esac
}

refresh_usage_command() {
  ensure_dirs
  local target=${1:-}
  local use_utc=${2:-0}
  local confirm_status=0
  local name error
  local index=0 total=0 failure_count=0
  local -a targets=() failure_names=() failure_errors=()
  if [[ -z "$target" ]]; then
    confirm_refresh_all_profiles || confirm_status=$?
    [[ $confirm_status -eq 0 ]] || return "$confirm_status"
    target="--all"
  fi

  while IFS= read -r name; do
    [[ -n "$name" ]] || continue
    targets+=("$name")
  done < <(collect_refresh_targets "$target")

  total=${#targets[@]}
  (( total > 0 )) || die "No saved profiles to refresh"

  for name in "${targets[@]}"; do
    index=$((index + 1))
    refresh_progress_begin "$index" "$total" "$name"
    error=""
    if error=$(refresh_usage_for_profile "$name"); then
      refresh_progress_finish "$index" "$total" "$name" "ok"
      continue
    fi
    failure_names+=("$name")
    failure_errors+=("$error")
    failure_count=$((failure_count + 1))
    refresh_progress_finish "$index" "$total" "$name" "fail" "$error"
  done

  refresh_progress_clear
  list_profiles "$use_utc"

  if (( failure_count > 0 )); then
    if (( failure_count == 1 )); then
      note "1 profile failed to refresh:"
    else
      note "$failure_count profiles failed to refresh:"
    fi
    for index in "${!failure_names[@]}"; do
      note "- ${failure_names[index]}: ${failure_errors[index]}"
    done
    return 1
  fi
  return 0
}

resolve_current_executable_path() {
  local script_ref=${1:-${BASH_SOURCE[0]:-$0}}
  python3 - "$script_ref" <<'PY'
import os
import shutil
import sys

script_ref = sys.argv[1]
if "/" not in script_ref:
    resolved = shutil.which(script_ref)
else:
    resolved = script_ref

if not resolved:
    raise SystemExit(1)

print(os.path.realpath(resolved))
PY
}

update_self() {
  require_cmd python3
  require_cmd curl

  local from_base installer_url script_path bin_dir parent_dir completion_dir installer_path
  local -a installer_args

  from_base="${CODEX_AUTH_INSTALL_FROM:-$DEFAULT_INSTALL_FROM_BASE}"
  from_base=${from_base%/}
  installer_url="$from_base/install.sh"

  script_path=$(resolve_current_executable_path "${BASH_SOURCE[0]:-$0}") || die "Unable to resolve the current executable path"
  bin_dir=$(CDPATH= cd -- "$(dirname -- "$script_path")" && pwd -P)
  parent_dir=$(CDPATH= cd -- "$bin_dir/.." && pwd -P)

  if [[ -f "$parent_dir/install.sh" && -f "$parent_dir/bin/codex-auth" && -f "$parent_dir/completions/codex-auth.bash" ]]; then
    die "codex-auth update is for installed copies; in a local checkout, run ./install.sh instead"
  fi

  installer_args=(--bin-dir "$bin_dir")

  if [[ "$(basename -- "$bin_dir")" == "bin" ]]; then
    completion_dir="$parent_dir/share/bash-completion/completions"
    if [[ -f "$completion_dir/codex-auth" ]]; then
      installer_args+=(--completion-dir "$completion_dir")
    else
      installer_args+=(--skip-completions)
    fi
  else
    installer_args+=(--skip-completions)
  fi

  installer_path=$(mktemp "${TMPDIR:-/tmp}/codex-auth-install.XXXXXX") || die "Failed to allocate a temporary installer path"
  if ! curl -fsSL "$installer_url" -o "$installer_path"; then
    rm -f "$installer_path"
    die "Failed to download installer from $installer_url"
  fi

  note "Updating codex-auth from $from_base"
  if bash "$installer_path" "${installer_args[@]}"; then
    rm -f "$installer_path"
  else
    local status=$?
    rm -f "$installer_path"
    return "$status"
  fi
}

main() {
  local cmd=${1:-help}
  case "$cmd" in
    help|-h|--help)
      usage
      ;;
    list)
      shift
      case "${1:-}" in
        "")
          list_profiles 0
          ;;
        --utc)
          [[ $# -eq 1 ]] || die "Usage: codex-auth list [--utc]"
          list_profiles 1
          ;;
        *)
          die "Usage: codex-auth list [--utc]"
          ;;
      esac
      ;;
    current)
      shift
      case "${1:-}" in
        "")
          show_current 0
          ;;
        --utc)
          [[ $# -eq 1 ]] || die "Usage: codex-auth current [--utc]"
          show_current 1
          ;;
        *)
          die "Usage: codex-auth current [--utc]"
          ;;
      esac
      ;;
    save)
      shift
      [[ $# -eq 1 ]] || die "Usage: codex-auth save <name>"
      save_profile "$1"
      ;;
    switch)
      shift
      [[ $# -le 1 ]] || die "Usage: codex-auth switch [name]"
      switch_profile "${1:-}"
      ;;
    add)
      shift
      [[ $# -eq 1 ]] || die "Usage: codex-auth add <name>"
      add_profile "$1"
      ;;
    refresh-usage|refresh)
      shift
      local refresh_target=""
      local refresh_use_utc=0
      while [[ $# -gt 0 ]]; do
        case "$1" in
          --utc)
            [[ $refresh_use_utc -eq 0 ]] || die "Usage: codex-auth refresh-usage [--utc] [<name>|--all]"
            refresh_use_utc=1
            ;;
          --all)
            [[ -z "$refresh_target" ]] || die "Usage: codex-auth refresh-usage [--utc] [<name>|--all]"
            refresh_target="--all"
            ;;
          -*)
            die "Usage: codex-auth refresh-usage [--utc] [<name>|--all]"
            ;;
          *)
            [[ -z "$refresh_target" ]] || die "Usage: codex-auth refresh-usage [--utc] [<name>|--all]"
            refresh_target="$1"
            ;;
        esac
        shift
      done
      refresh_usage_command "$refresh_target" "$refresh_use_utc"
      ;;
    update)
      shift
      [[ $# -eq 0 ]] || die "Usage: codex-auth update"
      update_self
      ;;
    rename)
      shift
      [[ $# -eq 2 ]] || die "Usage: codex-auth rename <old> <new>"
      rename_profile "$1" "$2"
      ;;
    remove|rm|delete)
      shift
      [[ $# -eq 1 ]] || die "Usage: codex-auth remove <name>"
      remove_profile "$1"
      ;;
    version|-v|--version)
      shift
      [[ $# -eq 0 ]] || die "Usage: codex-auth version"
      print_version
      ;;
    *)
      die "Unknown command '$cmd' (run 'codex-auth help')"
      ;;
  esac
}

main "$@"
