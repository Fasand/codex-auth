#!/usr/bin/env bash
set -euo pipefail

APP_VERSION="0.10.0"
export CODEX_AUTH_APP_VERSION="$APP_VERSION"
CODEX_HOME="${CODEX_HOME:-$HOME/.codex}"
AUTH_FILE="$CODEX_HOME/auth.json"
ACCOUNTS_DIR="$CODEX_HOME/accounts"
PROFILES_DIR="$ACCOUNTS_DIR/profiles"
CURRENT_PROFILE_FILE="$ACCOUNTS_DIR/current_profile"
SESSIONS_DIR="${CODEX_AUTH_SESSIONS_DIR:-$CODEX_HOME/sessions}"
CRON_DIR="$ACCOUNTS_DIR/cron"
CRON_LOG_FILE="${CODEX_AUTH_CRON_LOG_FILE:-$CRON_DIR/touch.log}"
CODEX_AUTH_CODEX_BIN="${CODEX_AUTH_CODEX_BIN:-codex}"
DEFAULT_CRON_BASE_PATH="/usr/local/bin:/usr/bin:/bin"
DEFAULT_USAGE_URL="https://chatgpt.com/backend-api/codex/usage"
FALLBACK_USAGE_URL="https://chatgpt.com/backend-api/wham/usage"
DEFAULT_INSTALL_FROM_BASE="https://raw.githubusercontent.com/Fasand/codex-auth/main"
DEFAULT_PRICING_URL="${CODEX_AUTH_PRICING_URL:-https://developers.openai.com/api/docs/pricing}"
DEFAULT_PRICING_CACHE_PATH="${CODEX_AUTH_PRICING_CACHE_PATH:-$ACCOUNTS_DIR/pricing-cache.json}"
DEFAULT_PRICING_CACHE_TTL_SECONDS="${CODEX_AUTH_PRICING_CACHE_TTL_SECONDS:-604800}"
DEFAULT_SESSION_STATS_CACHE_PATH="${CODEX_AUTH_SESSION_STATS_CACHE_PATH:-$ACCOUNTS_DIR/session-stats-cache.json}"
export CODEX_AUTH_THEME_HEADER_STYLE="${CODEX_AUTH_THEME_HEADER_STYLE:-1;97}"
export CODEX_AUTH_THEME_ACTIVE_STYLE="${CODEX_AUTH_THEME_ACTIVE_STYLE:-1;93}"
export CODEX_AUTH_THEME_PROFILE_STYLE="${CODEX_AUTH_THEME_PROFILE_STYLE:-36}"
export CODEX_AUTH_THEME_RESET_STYLE="${CODEX_AUTH_THEME_RESET_STYLE:-34}"
export CODEX_AUTH_THEME_DIM_STYLE="${CODEX_AUTH_THEME_DIM_STYLE:-2}"
export CODEX_AUTH_THEME_PLAN_STYLE="${CODEX_AUTH_THEME_PLAN_STYLE:-35}"
export CODEX_AUTH_THEME_COST_STYLE="${CODEX_AUTH_THEME_COST_STYLE:-32}"
export CODEX_AUTH_THEME_RATE_STYLE="${CODEX_AUTH_THEME_RATE_STYLE:-35}"
export CODEX_AUTH_THEME_PERCENT_OK_STYLE="${CODEX_AUTH_THEME_PERCENT_OK_STYLE:-32}"
export CODEX_AUTH_THEME_PERCENT_WARN_STYLE="${CODEX_AUTH_THEME_PERCENT_WARN_STYLE:-33}"
export CODEX_AUTH_THEME_PERCENT_BAD_STYLE="${CODEX_AUTH_THEME_PERCENT_BAD_STYLE:-31}"
export CODEX_AUTH_THEME_ISSUE_STYLE="${CODEX_AUTH_THEME_ISSUE_STYLE:-31}"

usage() {
  cat <<USAGE
Usage: codex-auth <command> [args]

Manage multiple ChatGPT Codex auth.json profiles.

Commands:
  list [--utc] [--with-stats]
                            List saved profiles with account info and cached usage
  current [--utc]           Show the currently active auth profile or current auth summary
  save <name>               Save the current auth.json as a named profile
  switch [name]             Switch to a saved profile (interactive if name omitted)
  add <name>                Run codex login, then save the result as <name>
  refresh-usage [--utc] [--with-stats] [<name>|--all]
                            Query live usage for one profile, or all profiles when no name is given
  refresh [--utc] [--with-stats] [<name>|--all]
                            Alias for refresh-usage
  token-status [--utc] [<name>|--all]
                            Show saved ID/access token expiry metadata
                            Defaults to all profiles when no name is provided
  touch <name>|--all        Run a minimal Codex request for profile(s), save live auth, and report whether tokens rotated
  cron [list|setup|add|delete|run]
                            Manage scheduled touch cron jobs
  stats [--utc] [--recompute] [--period <today|7d|14d|30d|all>]
                            Show global session token statistics from rollout history
  statistics [--utc] [--recompute] [--period <today|7d|14d|30d|all>]
                            Alias for stats
  update                    Update this installed codex-auth via install.sh
  rename <old> <new>        Rename a saved profile
  remove <name>             Delete a saved profile snapshot
  version                   Show the codex-auth version
  help                      Show this help

Environment:
  CODEX_HOME                Override Codex home (default: ~/.codex)
  CODEX_AUTH_INSTALL_FROM   Override installer source for self-update/advanced installs
  CODEX_AUTH_USAGE_URL      Override usage endpoint URL for testing/custom routing
  CODEX_AUTH_SESSIONS_DIR   Override sessions directory for session snapshot parsing
  CODEX_AUTH_PRICING_URL    Override pricing page URL for stats/cost estimation
  CODEX_AUTH_PRICING_CACHE_PATH  Override cached pricing file path
  CODEX_AUTH_PRICING_CACHE_TTL_SECONDS  Override pricing cache TTL (default: 604800)
  CODEX_AUTH_SESSION_STATS_CACHE_PATH  Override parsed session stats cache path
  CODEX_AUTH_CODEX_BIN    Override codex executable used by touch/cron
  CODEX_AUTH_CRON_LOG_FILE  Override scheduled touch log path
  CODEX_AUTH_CRON_PATH    Override PATH used by generated cron commands
  CODEX_AUTH_DISABLE_WHIPTAIL  Set to 1 to force numbered cron setup prompts
USAGE
}

print_version() {
  printf '%s\n' "$APP_VERSION"
}

die() {
  echo "codex-auth: $*" >&2
  exit 1
}

note() {
  echo "$*" >&2
}

have_cmd() {
  command -v "$1" >/dev/null 2>&1
}

require_cmd() {
  have_cmd "$1" || die "Required command not found: $1"
}

color_output_enabled() {
  [[ "${CODEX_AUTH_FORCE_COLOR:-0}" == "1" ]] && return 0
  [[ -n "${NO_COLOR:-}" ]] && return 1
  [[ "${TERM:-}" == "dumb" ]] && return 1
  [[ -t 1 ]]
}

style_color_enabled() {
  [[ "${CODEX_AUTH_FORCE_COLOR:-0}" == "1" ]] && return 0
  [[ -n "${NO_COLOR:-}" ]] && return 1
  [[ "${TERM:-}" == "dumb" ]] && return 1
  [[ -t 1 || -t 2 ]]
}

style_text() {
  local style_name=$1
  local text=$2
  if style_color_enabled; then
    local style=${!style_name-}
    if [[ -n "$style" ]]; then
      printf '\033[%sm%s\033[0m' "$style" "$text"
      return 0
    fi
  fi
  printf '%s' "$text"
}

ensure_dirs() {
  mkdir -p "$PROFILES_DIR"
}

require_auth_file() {
  [[ -f "$AUTH_FILE" ]] || die "No auth.json found at $AUTH_FILE"
}

validate_profile_name() {
  local name=${1:-}
  [[ -n "$name" ]] || die "Profile name is required"
  [[ "$name" =~ ^[A-Za-z0-9._-]+$ ]] || die "Invalid profile name '$name' (allowed: letters, numbers, dot, underscore, hyphen)"
}

profile_dir() {
  printf '%s\n' "$PROFILES_DIR/$1"
}

profile_auth_path() {
  printf '%s/auth.json\n' "$(profile_dir "$1")"
}

profile_meta_path() {
  printf '%s/meta.json\n' "$(profile_dir "$1")"
}

profile_usage_path() {
  printf '%s/usage.json\n' "$(profile_dir "$1")"
}

list_profile_names() {
  ensure_dirs
  local dir
  for dir in "$PROFILES_DIR"/*; do
    [[ -d "$dir" ]] || continue
    basename "$dir"
  done | sort
}

find_matching_profile() {
  [[ -f "$AUTH_FILE" ]] || return 1
  local name path
  while IFS= read -r name; do
    path=$(profile_auth_path "$name")
    [[ -f "$path" ]] || continue
    if cmp -s "$AUTH_FILE" "$path"; then
      printf '%s\n' "$name"
      return 0
    fi
  done < <(list_profile_names)
  return 1
}

write_current_profile_marker() {
  ensure_dirs
  printf '%s\n' "$1" > "$CURRENT_PROFILE_FILE"
}

clear_current_profile_marker_if_matches() {
  local name=${1:-}
  if [[ -f "$CURRENT_PROFILE_FILE" ]] && [[ "$(cat "$CURRENT_PROFILE_FILE")" == "$name" ]]; then
    rm -f "$CURRENT_PROFILE_FILE"
  fi
}

extract_meta_json() {
  local profile_name=$1
  local auth_path=$2
  python3 - "$profile_name" "$auth_path" <<'PY'
import base64
import datetime as dt
import json
import sys
from pathlib import Path

profile_name, auth_path = sys.argv[1:3]
obj = json.loads(Path(auth_path).read_text())
tokens = obj.get('tokens') or {}
id_token = tokens.get('id_token') or ''
access_token = tokens.get('access_token') or ''

def jwt_claims(token):
    if not isinstance(token, str) or '.' not in token:
        return {}
    parts = token.split('.')
    if len(parts) >= 2 and parts[1]:
        payload = parts[1] + '=' * (-len(parts[1]) % 4)
        try:
            return json.loads(base64.urlsafe_b64decode(payload.encode()).decode())
        except Exception:
            return {}
    return {}

id_claims = jwt_claims(id_token)
access_claims = jwt_claims(access_token)

def iso_from_epoch(value):
    if value is None:
        return None
    try:
        return dt.datetime.fromtimestamp(int(value), tz=dt.timezone.utc).strftime('%Y-%m-%dT%H:%M:%SZ')
    except Exception:
        return None

meta = {
    'profileName': profile_name,
    'savedAt': dt.datetime.now(dt.timezone.utc).strftime('%Y-%m-%dT%H:%M:%SZ'),
    'email': id_claims.get('email') or access_claims.get('email'),
    'emailVerified': id_claims.get('email_verified') if id_claims.get('email_verified') is not None else access_claims.get('email_verified'),
    'subject': id_claims.get('sub') or access_claims.get('sub'),
    'accountId': tokens.get('account_id'),
    'lastRefresh': obj.get('last_refresh'),
    # Backwards-compatible alias: historically this referred to the ID token.
    'tokenExpiresAt': iso_from_epoch(id_claims.get('exp')),
    'tokenExpiresEpoch': id_claims.get('exp'),
    'idTokenExpiresAt': iso_from_epoch(id_claims.get('exp')),
    'idTokenExpiresEpoch': id_claims.get('exp'),
    'accessTokenExpiresAt': iso_from_epoch(access_claims.get('exp')),
    'accessTokenExpiresEpoch': access_claims.get('exp'),
    'hasRefreshToken': bool(tokens.get('refresh_token')),
    'authProvider': id_claims.get('auth_provider') or access_claims.get('auth_provider'),
}
print(json.dumps(meta, indent=2, sort_keys=True))
PY
}

write_meta_file() {
  local profile_name=$1
  local auth_path=$2
  local meta_path=$3
  extract_meta_json "$profile_name" "$auth_path" > "$meta_path"
}

# Returns 0 only when the auth.json at $1 verifiably belongs to the same
# account as the profile meta.json at $2 (account_id match, falling back to
# email). Unverifiable identity counts as a mismatch, to keep callers from
# cross-contaminating snapshots.
live_auth_matches_profile() {
  local auth_file=$1
  local meta_path=$2
  [[ -f "$auth_file" && -f "$meta_path" ]] || return 1
  python3 - "$auth_file" "$meta_path" <<'PY'
import base64
import json
import sys
from pathlib import Path

auth_path, meta_path = sys.argv[1:3]
try:
    auth = json.loads(Path(auth_path).read_text())
    meta = json.loads(Path(meta_path).read_text())
except Exception:
    raise SystemExit(1)
if not isinstance(auth, dict) or not isinstance(meta, dict):
    raise SystemExit(1)
tokens = auth.get('tokens')
if not isinstance(tokens, dict):
    raise SystemExit(1)

live_account = tokens.get('account_id') or ''
meta_account = meta.get('accountId') or ''
if live_account and meta_account:
    raise SystemExit(0 if live_account == meta_account else 1)


def jwt_claims(token):
    if not isinstance(token, str) or '.' not in token:
        return {}
    parts = token.split('.')
    if len(parts) < 2 or not parts[1]:
        return {}
    payload = parts[1] + '=' * (-len(parts[1]) % 4)
    try:
        decoded = json.loads(base64.urlsafe_b64decode(payload.encode()).decode())
    except Exception:
        return {}
    return decoded if isinstance(decoded, dict) else {}


live_email = jwt_claims(tokens.get('id_token')).get('email') or jwt_claims(tokens.get('access_token')).get('email') or ''
meta_email = meta.get('email') or ''
if live_email and meta_email:
    raise SystemExit(0 if live_email == meta_email else 1)
raise SystemExit(1)
PY
}

latest_session_snapshot_json() {
  local sessions_dir=$1
  python3 - "$sessions_dir" <<'PY'
import datetime as dt
import json
import math
import os
import sys
from pathlib import Path

sessions_dir = Path(sys.argv[1])
if not sessions_dir.exists():
    raise SystemExit(1)

# Session snapshots older than this are ignored: rollout files carry no
# account identity, so an old snapshot may describe a different login or a
# long-gone rate-limit window.
MAX_SNAPSHOT_AGE_SECONDS = 3600


def parse_iso(value):
    if not value:
        return None
    text = str(value).strip()
    if text.endswith('Z'):
        text = text[:-1] + '+00:00'
    try:
        parsed = dt.datetime.fromisoformat(text)
    except ValueError:
        return None
    if parsed.tzinfo is None:
        parsed = parsed.replace(tzinfo=dt.timezone.utc)
    return parsed


now_utc = parse_iso(os.environ.get('CODEX_AUTH_NOW')) or dt.datetime.now(dt.timezone.utc)

files = sorted(sessions_dir.glob('**/rollout-*.jsonl'), key=lambda p: p.stat().st_mtime, reverse=True)
for path in files:
    try:
        lines = path.read_text(encoding='utf-8', errors='replace').splitlines()
    except Exception:
        continue
    for line in reversed(lines):
        try:
            obj = json.loads(line)
        except Exception:
            continue
        payload = obj.get('payload') if obj.get('type') == 'event_msg' else None
        if not isinstance(payload, dict) or payload.get('type') != 'token_count':
            continue
        info = payload.get('info') or {}
        last_usage = info.get('last_token_usage') or {}
        model_context_window = info.get('model_context_window')
        total = last_usage.get('total_tokens')
        if not model_context_window or total is None:
            continue
        try:
            context_used = int(round((float(total) / float(model_context_window)) * 100))
        except Exception:
            context_used = None
        captured_at = parse_iso(obj.get('timestamp'))
        if captured_at is None or (now_utc - captured_at).total_seconds() > MAX_SNAPSHOT_AGE_SECONDS:
            raise SystemExit(1)
        rate_limits = payload.get('rate_limits') or {}
        primary = rate_limits.get('primary') or {}
        secondary = rate_limits.get('secondary') or {}
        snapshot = {
            'source': 'session',
            'capturedAt': obj.get('timestamp'),
            'rolloutPath': str(path),
            'context_used_percent': context_used,
            'effective_context_window': int(model_context_window),
            'five_hour_used_percent': None if primary.get('used_percent') is None else int(round(float(primary.get('used_percent')))),
            'weekly_used_percent': None if secondary.get('used_percent') is None else int(round(float(secondary.get('used_percent')))),
            'five_hour_reset_at': primary.get('resets_at'),
            'weekly_reset_at': secondary.get('resets_at'),
            'plan_type': rate_limits.get('plan_type'),
        }
        if snapshot['five_hour_used_percent'] is not None:
            snapshot['five_hour_remaining_percent'] = max(0, 100 - snapshot['five_hour_used_percent'])
        if snapshot['weekly_used_percent'] is not None:
            snapshot['weekly_remaining_percent'] = max(0, 100 - snapshot['weekly_used_percent'])
        print(json.dumps(snapshot))
        raise SystemExit(0)
raise SystemExit(1)
PY
}

refresh_usage_python() {
  local auth_path=$1
  local usage_path=$2
  local include_session=${3:-0}
  local session_json=${4:-}
  local profile_name=${5:-}
  python3 - "$auth_path" "$usage_path" "$DEFAULT_USAGE_URL" "$FALLBACK_USAGE_URL" "$include_session" "$session_json" "$profile_name" "$APP_VERSION" <<'PY'
import datetime as dt
import json
import os
import sys
import urllib.error
import urllib.request
from pathlib import Path

auth_path, usage_path, default_url, fallback_url, include_session, session_json, profile_name, app_version = sys.argv[1:9]
obj = json.loads(Path(auth_path).read_text())
tokens = obj.get('tokens') or {}
access_token = tokens.get('access_token')
account_id = tokens.get('account_id')
if not access_token or not account_id:
    raise SystemExit('Missing access_token or account_id in auth snapshot')


def derived_from_backend(data):
    rate = data.get('rate_limit') or {}
    primary = rate.get('primary_window') or {}
    secondary = rate.get('secondary_window') or {}
    derived = {
        'five_hour_used_percent': primary.get('used_percent'),
        'weekly_used_percent': secondary.get('used_percent'),
        'five_hour_remaining_percent': None,
        'weekly_remaining_percent': None,
        'five_hour_reset_at': primary.get('reset_at'),
        'weekly_reset_at': secondary.get('reset_at'),
        'five_hour_reset_after_seconds': primary.get('reset_after_seconds'),
        'weekly_reset_after_seconds': secondary.get('reset_after_seconds'),
    }
    if primary.get('used_percent') is not None:
        derived['five_hour_remaining_percent'] = max(0, 100 - int(round(float(primary.get('used_percent')))))
    if secondary.get('used_percent') is not None:
        derived['weekly_remaining_percent'] = max(0, 100 - int(round(float(secondary.get('used_percent')))))
    return derived


def make_error_message(message, *, code=None):
    prefix = f"Unable to refresh usage for '{profile_name}':" if profile_name else "Unable to refresh usage:"
    parts = [prefix]
    if code:
        parts.append(f"{code}:")
    parts.append(message)
    return ' '.join(parts)


def auth_relogin_message(message, *, code=None):
    command = "codex logout && codex login && codex-auth save <profile>"
    if profile_name:
        command = f"codex-auth switch {profile_name} && codex logout && codex login && codex-auth save {profile_name}"
    return make_error_message(
        f"{message} This profile needs to be logged in again. Run: {command}",
        code=code,
    )


def parse_error_payload(raw):
    try:
        payload = json.loads(raw)
    except Exception:
        return None
    if not isinstance(payload, dict):
        return None
    error = payload.get('error')
    if not isinstance(error, dict):
        return None
    return {
        'code': error.get('code'),
        'message': error.get('message'),
        'status': payload.get('status'),
    }

urls = []
custom_url = os.environ.get('CODEX_AUTH_USAGE_URL')
if custom_url:
    urls.append(custom_url)
else:
    urls.extend([default_url, fallback_url])

last_error = None
for url in urls:
    req = urllib.request.Request(
        url,
        headers={
            'Authorization': f'Bearer {access_token}',
            'ChatGPT-Account-Id': account_id,
            'Accept': 'application/json',
            'User-Agent': f'codex-auth/{app_version}',
        },
    )
    try:
        with urllib.request.urlopen(req, timeout=20) as resp:
            raw = resp.read().decode('utf-8', 'replace')
            data = json.loads(raw)
            payload = {
                'fetchedAt': dt.datetime.now(dt.timezone.utc).strftime('%Y-%m-%dT%H:%M:%SZ'),
                'source': 'live',
                'url': url,
                # The fallback endpoint may account usage against a different
                # limit bucket; the display marks its numbers as approximate.
                'endpoint': 'primary' if (custom_url or url == default_url) else 'fallback',
            }
            payload.update(data)
            payload['backend_derived'] = derived_from_backend(payload)
            payload['derived'] = dict(payload['backend_derived'])
            if include_session == '1' and session_json:
                try:
                    payload['session'] = json.loads(session_json)
                    for key in (
                        'five_hour_used_percent',
                        'weekly_used_percent',
                        'five_hour_remaining_percent',
                        'weekly_remaining_percent',
                        'five_hour_reset_at',
                        'weekly_reset_at',
                    ):
                        if payload['derived'].get(key) is None:
                            value = payload['session'].get(key)
                            if value is not None:
                                payload['derived'][key] = value
                except Exception:
                    pass
            Path(usage_path).write_text(json.dumps(payload, indent=2, sort_keys=True), encoding='utf-8')
            print(json.dumps(payload))
            raise SystemExit(0)
    except urllib.error.HTTPError as exc:
        body = exc.read().decode('utf-8', 'replace')
        parsed = parse_error_payload(body)
        error_code = parsed.get('code') if parsed else None
        error_message = parsed.get('message') if parsed and parsed.get('message') else str(exc)
        if exc.code == 401:
            lower_message = error_message.lower()
            if (
                error_code == 'token_expired'
                or 'expired' in lower_message
                or 'sign in again' in lower_message
                or 'signing in again' in lower_message
            ):
                raise SystemExit(auth_relogin_message(error_message, code=error_code or '401'))
            raise SystemExit(make_error_message(error_message, code=error_code or '401'))
        if parsed and error_message:
            last_error = make_error_message(error_message, code=error_code or exc.code)
        else:
            last_error = make_error_message(str(exc))
    except Exception as exc:
        last_error = make_error_message(str(exc))

raise SystemExit(last_error)
PY
}

record_profile_refresh_error() {
  local profile_name=$1
  local usage_path=$2
  local message=$3
  python3 - "$profile_name" "$usage_path" "$message" <<'PY'
import datetime as dt
import json
import re
import sys
from pathlib import Path

profile_name, usage_path, message = sys.argv[1:4]
path = Path(usage_path)
try:
    usage = json.loads(path.read_text(encoding='utf-8')) if path.exists() else {}
    if not isinstance(usage, dict):
        usage = {}
except Exception:
    usage = {}

summary = ' '.join(str(message or '').split())
prefix = f"Unable to refresh usage for '{profile_name}': "
if summary.startswith(prefix):
    summary = summary[len(prefix):]
summary = re.split(r'\s+This profile needs to be logged in again\.', summary, maxsplit=1)[0]
summary = re.split(r'\s+Run:\s+', summary, maxsplit=1)[0]
summary = summary.strip() or 'refresh failed'

if 'token expired in both snapshot and live session' in summary.lower():
    summary = 'token expired — re-login required'

if len(summary) > 120:
    summary = summary[:117].rstrip() + '...'

usage['lastRefreshError'] = {
    'failedAt': dt.datetime.now(dt.timezone.utc).strftime('%Y-%m-%dT%H:%M:%SZ'),
    'summary': summary,
    'message': str(message or '').strip(),
}
path.parent.mkdir(parents=True, exist_ok=True)
path.write_text(json.dumps(usage, indent=2, sort_keys=True), encoding='utf-8')
PY
}

profile_display_payload_json() {
  local profile_name=$1
  local meta_path=$2
  local usage_path=$3
  local active_name=${4:-}
  local use_utc=${5:-0}
  python3 - "$profile_name" "$meta_path" "$usage_path" "$active_name" "$use_utc" <<'PY'
import datetime as dt
import json
import sys
from pathlib import Path

profile_name, meta_path, usage_path, active_name, use_utc = sys.argv[1:6]
meta = json.loads(Path(meta_path).read_text()) if Path(meta_path).exists() else {}
usage = json.loads(Path(usage_path).read_text()) if Path(usage_path).exists() else {}
derived = usage.get('derived') or {}
session = usage.get('session') or {}
last_error = usage.get('lastRefreshError') or {}
is_active = profile_name == active_name
local_tz = dt.datetime.now().astimezone().tzinfo or dt.timezone.utc


def first_value(*values):
    for value in values:
        if value not in (None, '', [], {}):
            return value
    return None


def parse_datetime(value):
    if value in (None, '', [], {}):
        return None
    if isinstance(value, (int, float)):
        return dt.datetime.fromtimestamp(float(value), tz=dt.timezone.utc)
    text = str(value).strip()
    if not text:
        return None
    if text.isdigit():
        return dt.datetime.fromtimestamp(int(text), tz=dt.timezone.utc)
    normalized = text[:-1] + '+00:00' if text.endswith('Z') else text
    try:
        parsed = dt.datetime.fromisoformat(normalized)
    except ValueError:
        return None
    if parsed.tzinfo is None:
        parsed = parsed.replace(tzinfo=dt.timezone.utc)
    return parsed


def format_datetime(value):
    parsed = parse_datetime(value)
    if parsed is None:
        return ''
    if use_utc == '1':
        return parsed.astimezone(dt.timezone.utc).strftime('%Y-%m-%d %H:%MZ')
    localized = parsed.astimezone(local_tz)
    tz_name = localized.tzname() or 'UTC'
    return localized.strftime('%d %b %H:%M ') + tz_name


def format_percent(value):
    if value in (None, ''):
        return ''
    try:
        return f"{int(round(float(value)))}%"
    except Exception:
        return str(value)


backend = usage.get('backend_derived')
# Legacy usage.json files predate the 'endpoint' field; infer fallback
# fetches from the recorded URL until the next refresh rewrites the file.
fallback_endpoint = usage.get('endpoint') == 'fallback' or (
    'endpoint' not in usage and str(usage.get('url') or '').endswith('/wham/usage')
)


def percent_with_source(key):
    # Values that did not come straight from the primary usage endpoint
    # (session-snapshot backfill or the fallback endpoint) are approximate:
    # session rollouts carry no account identity and the fallback endpoint may
    # use a different limit bucket. Prefix them with '~' so they can't be
    # mistaken for live numbers.
    value = derived.get(key)
    approx = value is not None and isinstance(backend, dict) and backend.get(key) is None
    if value is None:
        value = session.get(key)
        approx = value is not None
    text = format_percent(value)
    if text and (approx or fallback_endpoint):
        text = '~' + text
    return text


payload = {
    'active': is_active,
    'profile': profile_name,
    'email': meta.get('email') or '',
    'account': meta.get('accountId') or '',
    'plan': first_value(usage.get('plan_type'), session.get('plan_type')) or '',
    'five_hour': percent_with_source('five_hour_remaining_percent'),
    'five_hour_reset': format_datetime(first_value(derived.get('five_hour_reset_at'), session.get('five_hour_reset_at'))),
    'weekly': percent_with_source('weekly_remaining_percent'),
    'weekly_reset': format_datetime(first_value(derived.get('weekly_reset_at'), session.get('weekly_reset_at'))),
    'checked': format_datetime(usage.get('fetchedAt')),
    'token_expires': format_datetime(meta.get('tokenExpiresAt')),
    'last_refresh': format_datetime(meta.get('lastRefresh')),
    'issue': last_error.get('summary') if isinstance(last_error, dict) else '',
    'issue_failed_at': format_datetime(last_error.get('failedAt')) if isinstance(last_error, dict) else '',
}
print(json.dumps(payload))
PY
}

render_profile_line() {
  local profile_name=$1
  local active_name=${2:-}
  local use_utc=${3:-0}
  local meta_path usage_path
  local payload_json
  meta_path=$(profile_meta_path "$profile_name")
  usage_path=$(profile_usage_path "$profile_name")
  payload_json=$(profile_display_payload_json "$profile_name" "$meta_path" "$usage_path" "$active_name" "$use_utc")
  python3 - "$payload_json" <<'PY'
import json
import os
import re
import sys

payload = json.loads(sys.argv[1])


def use_color():
    if os.environ.get('CODEX_AUTH_FORCE_COLOR') == '1':
        return True
    if os.environ.get('NO_COLOR'):
        return False
    if os.environ.get('TERM') == 'dumb':
        return False
    return sys.stdout.isatty()


def paint(text, style_name):
    if not text:
        return text
    if not use_color():
        return text
    style = os.environ.get(style_name, '')
    return f"\033[{style}m{text}\033[0m" if style else text


def percent_style(value):
    match = re.search(r'(\d+)', value or '')
    if not match:
        return value
    amount = int(match.group(1))
    if amount >= 67:
        return paint(value, 'CODEX_AUTH_THEME_PERCENT_OK_STYLE')
    if amount >= 34:
        return paint(value, 'CODEX_AUTH_THEME_PERCENT_WARN_STYLE')
    return paint(value, 'CODEX_AUTH_THEME_PERCENT_BAD_STYLE')


parts = []
marker = paint('*', 'CODEX_AUTH_THEME_ACTIVE_STYLE') if payload.get('active') else '-'
profile_style = 'CODEX_AUTH_THEME_ISSUE_STYLE' if payload.get('issue') else 'CODEX_AUTH_THEME_PROFILE_STYLE'
parts.append(f"{marker} {paint(payload.get('profile') or 'unknown-profile', profile_style)}")
if payload.get('email'):
    parts.append(payload['email'])
if payload.get('account'):
    parts.append(f"account={payload['account']}")
if payload.get('plan'):
    parts.append(f"plan={paint(payload['plan'], 'CODEX_AUTH_THEME_PLAN_STYLE')}")
if payload.get('five_hour'):
    segment = f"5h {percent_style(payload['five_hour'])}"
    if payload.get('five_hour_reset'):
        segment += f" (resets {paint(payload['five_hour_reset'], 'CODEX_AUTH_THEME_RESET_STYLE')})"
    parts.append(segment)
if payload.get('weekly'):
    segment = f"weekly {percent_style(payload['weekly'])}"
    if payload.get('weekly_reset'):
        segment += f" (resets {paint(payload['weekly_reset'], 'CODEX_AUTH_THEME_RESET_STYLE')})"
    parts.append(segment)
if payload.get('checked'):
    parts.append(f"checked={paint(payload['checked'], 'CODEX_AUTH_THEME_DIM_STYLE')}")
if payload.get('issue'):
    parts.append(f"issue={paint(payload['issue'], 'CODEX_AUTH_THEME_ISSUE_STYLE')}")
print(' | '.join(parts))
PY
}


profile_switch_row_tsv() {
  local profile_name=$1
  local active_name=${2:-}
  local meta_path usage_path
  meta_path=$(profile_meta_path "$profile_name")
  usage_path=$(profile_usage_path "$profile_name")
  python3 - "$profile_name" "$meta_path" "$usage_path" "$active_name" <<'PY'
import json
import sys
from pathlib import Path

profile_name, meta_path, usage_path, active_name = sys.argv[1:5]
meta = json.loads(Path(meta_path).read_text()) if Path(meta_path).exists() else {}
usage = json.loads(Path(usage_path).read_text()) if Path(usage_path).exists() else {}
derived = usage.get('derived') or {}
is_active = profile_name == active_name

def ellipsize(value, width):
    value = '' if value is None else str(value)
    if len(value) <= width:
        return value.ljust(width)
    if width <= 1:
        return value[:width]
    return value[:width - 1] + '…'

def pct(value):
    if value in (None, ''):
        return '  -'
    try:
        return f"{int(round(float(value))):>3}%"
    except Exception:
        return str(value).rjust(4)

active = '*' if is_active else ' '
profile_col = ellipsize(profile_name, 24)
email_col = ellipsize(meta.get('email') or '', 32)
fiveh_col = pct(derived.get('five_hour_remaining_percent'))
weekly_col = pct(derived.get('weekly_remaining_percent'))
display = f"{active} {profile_col}  {email_col}  5h {fiveh_col}  wk {weekly_col}"
print(f"{profile_name}	{display}")
PY
}

refresh_usage_for_profile() {
  local profile_name=$1
  validate_profile_name "$profile_name"
  local dir auth_path usage_path include_session=0 session_json="" error_file output status
  dir=$(profile_dir "$profile_name")
  [[ -d "$dir" ]] || die "Unknown profile '$profile_name'"
  auth_path=$(profile_auth_path "$profile_name")
  usage_path=$(profile_usage_path "$profile_name")
  if [[ -f "$AUTH_FILE" ]] && cmp -s "$AUTH_FILE" "$auth_path"; then
    if session_json=$(latest_session_snapshot_json "$SESSIONS_DIR" 2>/dev/null); then
      include_session=1
    fi
  fi
  error_file=$(mktemp)
  if refresh_usage_python "$auth_path" "$usage_path" "$include_session" "$session_json" "$profile_name" >/dev/null 2>"$error_file"; then
    rm -f "$error_file"
    return 0
  else
    status=$?
  fi
  output=$(cat "$error_file")
  rm -f "$error_file"
  output=${output//$'\n'/ }

  # Fallback: if the error looks like a token_expired 401 and this is the
  # currently selected profile, retry with the live auth.json.
  if [[ "$output" == *"token_expired"* || "$output" == *"expired"* || "$output" == *"sign in again"* || "$output" == *"signing in again"* ]]; then
    local current_name=""
    if [[ -f "$CURRENT_PROFILE_FILE" ]]; then
      current_name=$(cat "$CURRENT_PROFILE_FILE")
    fi
    if [[ -n "$current_name" && "$current_name" == "$profile_name" && -f "$AUTH_FILE" ]] \
      && live_auth_matches_profile "$AUTH_FILE" "$(profile_meta_path "$profile_name")"; then
      # The snapshot may be stale — retry with the live session token.
      # The identity guard above keeps a live auth.json that belongs to a
      # different account (manual codex login) from being queried as this
      # profile or synced over its snapshot.
      local live_error_file live_output live_status
      live_error_file=$(mktemp)
      if refresh_usage_python "$AUTH_FILE" "$usage_path" "$include_session" "$session_json" "$profile_name" >/dev/null 2>"$live_error_file"; then
        rm -f "$live_error_file"
        # Success with live token — sync snapshot from live session
        local meta_path
        meta_path=$(profile_meta_path "$profile_name")
        cp "$AUTH_FILE" "$auth_path"
        write_meta_file "$profile_name" "$auth_path" "$meta_path"
        note "snapshot was stale — auto-synced from live Codex session"
        return 0
      else
        live_status=$?
      fi
      live_output=$(cat "$live_error_file")
      rm -f "$live_error_file"
      live_output=${live_output//$'\n'/ }
      if [[ "$live_output" == *"token_expired"* || "$live_output" == *"expired"* || "$live_output" == *"sign in again"* || "$live_output" == *"signing in again"* ]]; then
        local token_expired_message="Token expired in both snapshot and live session — please re-login"
        record_profile_refresh_error "$profile_name" "$usage_path" "$token_expired_message"
        printf '%s\n' "$token_expired_message"
        return "$live_status"
      fi
      # Live token failed with a different error — report it
      record_profile_refresh_error "$profile_name" "$usage_path" "$live_output"
      printf '%s\n' "$live_output"
      return "$live_status"
    fi
  fi

  record_profile_refresh_error "$profile_name" "$usage_path" "$output"
  printf '%s\n' "$output"
  return "$status"
}

best_effort_refresh_usage() {
  local profile_name=$1
  refresh_usage_for_profile "$profile_name" >/dev/null 2>&1 || true
}

refresh_progress_bar() {
  local completed=$1
  local total=$2
  local width=${3:-12}
  local filled=0 empty=0 i
  (( total > 0 )) || total=1
  (( completed < 0 )) && completed=0
  (( completed > total )) && completed=$total
  filled=$(( completed * width / total ))
  empty=$(( width - filled ))
  printf '['
  for ((i = 0; i < filled; i++)); do
    printf '#'
  done
  for ((i = 0; i < empty; i++)); do
    printf '.'
  done
  printf ']'
}

refresh_progress_begin() {
  local index=$1
  local total=$2
  local profile_name=$3
  if [[ -t 2 ]]; then
    printf '\rRefreshing %d/%d %s %s...\033[K' "$index" "$total" "$(refresh_progress_bar "$((index - 1))" "$total")" "$profile_name" >&2
  else
    printf 'Refreshing %d/%d: %s... ' "$index" "$total" "$profile_name" >&2
  fi
}

refresh_progress_finish() {
  local index=$1
  local total=$2
  local profile_name=$3
  local outcome=$4
  local detail=${5:-}
  if [[ -t 2 ]]; then
    if [[ "$outcome" == "ok" ]]; then
      printf '\rRefreshed  %d/%d %s %s\033[K' "$index" "$total" "$(refresh_progress_bar "$index" "$total")" "$profile_name" >&2
    else
      printf '\rFailed     %d/%d %s %s — see summary below\033[K' "$index" "$total" "$(refresh_progress_bar "$index" "$total")" "$profile_name" >&2
    fi
    return 0
  fi

  if [[ "$outcome" == "ok" ]]; then
    note "Refreshed $profile_name"
  else
    note "Failed $profile_name"
  fi
}

refresh_progress_clear() {
  [[ -t 2 ]] || return 0
  printf '\r\033[K' >&2
}

collect_refresh_targets() {
  local target=${1:-}
  local name
  if [[ "$target" == "--all" ]]; then
    while IFS= read -r name; do
      [[ -n "$name" ]] || continue
      printf '%s\n' "$name"
    done < <(list_profile_names)
    return 0
  fi

  validate_profile_name "$target"
  [[ -d "$(profile_dir "$target")" ]] || die "Unknown profile '$target'"
  printf '%s\n' "$target"
}

render_profile_table() {
  local payload_file=$1
  local color_enabled=0
  if color_output_enabled; then
    color_enabled=1
  fi

  python3 - "$payload_file" "$color_enabled" <<'PY'
import json
import os
import re
import sys
from pathlib import Path

rows = []
for line in Path(sys.argv[1]).read_text(encoding='utf-8').splitlines():
    line = line.strip()
    if line:
        rows.append(json.loads(line))

if not rows:
    raise SystemExit(0)

color_enabled = sys.argv[2] == '1'


def paint(text, style_name):
    if not text or not color_enabled:
        return text
    style = os.environ.get(style_name, '')
    return f"\033[{style}m{text}\033[0m" if style else text


def percent_style(value):
    match = re.search(r'(\d+)', value or '')
    if not match:
        return value
    amount = int(match.group(1))
    if amount >= 67:
        return paint(value, 'CODEX_AUTH_THEME_PERCENT_OK_STYLE')
    if amount >= 34:
        return paint(value, 'CODEX_AUTH_THEME_PERCENT_WARN_STYLE')
    return paint(value, 'CODEX_AUTH_THEME_PERCENT_BAD_STYLE')


def profile_cell(row):
    marker = paint('*', 'CODEX_AUTH_THEME_ACTIVE_STYLE') if row.get('active') else ' '
    style = 'CODEX_AUTH_THEME_ISSUE_STYLE' if row.get('issue') else 'CODEX_AUTH_THEME_PROFILE_STYLE'
    profile = paint(row.get('profile') or '', style)
    return f"{marker} {profile}"


healthy_rows = [row for row in rows if not row.get('issue')]
issue_rows = [row for row in rows if row.get('issue')]
display_rows = healthy_rows + issue_rows

profile_plain_cells = [("* " if row.get('active') else "  ") + (row.get('profile') or '') for row in display_rows]
headers = ['PROFILE', 'EMAIL', 'PLAN', '5H', 'RESET', 'WEEKLY', 'RESET', 'CHECKED']
columns = [
    profile_plain_cells,
    [row.get('email') or '' for row in display_rows],
    [row.get('plan') or '' for row in display_rows],
    [row.get('five_hour') or '' for row in display_rows],
    [row.get('five_hour_reset') or '' for row in display_rows],
    [row.get('weekly') or '' for row in display_rows],
    [row.get('weekly_reset') or '' for row in display_rows],
    [row.get('checked') or '' for row in display_rows],
]
widths = []
for header, values in zip(headers, columns):
    widths.append(max([len(header)] + [len(value) for value in values]))


def pad(value, width):
    return (value or '').ljust(width)


def table_width():
    # Mirrors the fixed table layout without adding transient issue text to column widths.
    return sum(widths) + 19


def issue_heading():
    count = len(issue_rows)
    noun = 'profile' if count == 1 else 'profiles'
    verb = 'needs' if count == 1 else 'need'
    return paint(f"Refresh issue: {count} {noun} {verb} attention", 'CODEX_AUTH_THEME_ISSUE_STYLE')


def issue_line(row):
    message = row.get('issue') or 'refresh failed'
    return paint(f"↳ issue: {message}", 'CODEX_AUTH_THEME_ISSUE_STYLE')


def render_row(index, header=False):
    row = display_rows[index] if not header else None
    values = [
        headers[0] if header else pad(profile_plain_cells[index], widths[0]),
        headers[1] if header else pad(row.get('email') or '', widths[1]),
        headers[2] if header else pad(row.get('plan') or '', widths[2]),
        headers[3] if header else pad(row.get('five_hour') or '', widths[3]),
        headers[4] if header else pad(row.get('five_hour_reset') or '', widths[4]),
        headers[5] if header else pad(row.get('weekly') or '', widths[5]),
        headers[6] if header else pad(row.get('weekly_reset') or '', widths[6]),
        headers[7] if header else pad(row.get('checked') or '', widths[7]),
    ]
    if header:
        values = [pad(value, width) for value, width in zip(values, widths)]
        values = [paint(value, 'CODEX_AUTH_THEME_HEADER_STYLE') for value in values]
    else:
        values[0] = profile_cell(row) + (' ' * max(0, widths[0] - len(profile_plain_cells[index])))
        if row.get('plan'):
            values[2] = paint(pad(row.get('plan') or '', widths[2]), 'CODEX_AUTH_THEME_PLAN_STYLE')
        if row.get('five_hour'):
            values[3] = percent_style(pad(row.get('five_hour') or '', widths[3]))
        if row.get('five_hour_reset'):
            values[4] = paint(pad(row.get('five_hour_reset') or '', widths[4]), 'CODEX_AUTH_THEME_RESET_STYLE')
        if row.get('weekly'):
            values[5] = percent_style(pad(row.get('weekly') or '', widths[5]))
        if row.get('weekly_reset'):
            values[6] = paint(pad(row.get('weekly_reset') or '', widths[6]), 'CODEX_AUTH_THEME_RESET_STYLE')
        if row.get('checked'):
            values[7] = paint(pad(row.get('checked') or '', widths[7]), 'CODEX_AUTH_THEME_DIM_STYLE')
    return f"{values[0]}  {values[1]}  {values[2]} | {values[3]}  {values[4]} | {values[5]}  {values[6]} | {values[7]}".rstrip()


print(render_row(0, header=True))
for index in range(len(display_rows)):
    if issue_rows and index == len(healthy_rows):
        print(paint('-' * max(24, table_width()), 'CODEX_AUTH_THEME_ISSUE_STYLE'))
        print(issue_heading())
    print(render_row(index))
    if display_rows[index].get('issue'):
        print(issue_line(display_rows[index]))
PY
}

render_session_stats() {
  local mode=$1
  local use_utc=${2:-0}
  local focus_period=${3:-30d}
  local daily_limit=${4:-31}
  local force_recompute=${5:-0}
  python3 - "$mode" "$SESSIONS_DIR" "$DEFAULT_PRICING_URL" "$DEFAULT_PRICING_CACHE_PATH" "$DEFAULT_PRICING_CACHE_TTL_SECONDS" "$use_utc" "$focus_period" "$daily_limit" "$DEFAULT_SESSION_STATS_CACHE_PATH" "$force_recompute" <<'PY'
import datetime as dt
import html
import json
import os
import re
import sys
import urllib.request
from collections import defaultdict
from pathlib import Path

mode, sessions_dir_arg, pricing_url, pricing_cache_path, pricing_ttl, use_utc, focus_period, daily_limit, session_stats_cache_path, force_recompute = sys.argv[1:11]
sessions_dir = Path(sessions_dir_arg)
cache_path = Path(pricing_cache_path)
stats_cache_path = Path(session_stats_cache_path)
force_recompute = force_recompute == '1'
color_enabled = os.environ.get('CODEX_AUTH_FORCE_COLOR') == '1' or (
    not os.environ.get('NO_COLOR') and os.environ.get('TERM') != 'dumb' and sys.stdout.isatty()
)


def paint(text, style_name):
    if not text or not color_enabled:
        return text
    style = os.environ.get(style_name, '')
    return f"\033[{style}m{text}\033[0m" if style else text


def parse_dt(value):
    if value in (None, '', [], {}):
        return None
    if isinstance(value, (int, float)):
        return dt.datetime.fromtimestamp(float(value), tz=dt.timezone.utc)
    text = str(value).strip()
    if text.endswith('Z'):
        text = text[:-1] + '+00:00'
    parsed = dt.datetime.fromisoformat(text)
    if parsed.tzinfo is None:
        parsed = parsed.replace(tzinfo=dt.timezone.utc)
    return parsed.astimezone(dt.timezone.utc)


now_override = os.environ.get('CODEX_AUTH_NOW')
now_utc = parse_dt(now_override) if now_override else dt.datetime.now(dt.timezone.utc)
local_tz = dt.timezone.utc if use_utc == '1' else (dt.datetime.now().astimezone().tzinfo or dt.timezone.utc)
now_local = now_utc.astimezone(local_tz)


def human_tokens(value):
    if value is None:
        return '—'
    value = int(round(value))
    abs_value = abs(value)
    if abs_value >= 1_000_000_000:
        return f"{value / 1_000_000_000:.2f}B".rstrip('0').rstrip('.')
    if abs_value >= 1_000_000:
        return f"{value / 1_000_000:.2f}M".rstrip('0').rstrip('.')
    if abs_value >= 1_000:
        return f"{value / 1_000:.1f}k".rstrip('0').rstrip('.')
    return str(value)


def money(value):
    if value is None:
        return 'n/a'
    if 0 < value < 0.01:
        return f"${value:,.4f}"
    return f"${value:,.2f}"


def pct(part, whole):
    if not whole:
        return '0%'
    return f"{(part / whole) * 100:.1f}%"


def session_label(count):
    return 'session' if count == 1 else 'sessions'


def section_rule(width=92, char='─'):
    return paint(char * width, 'CODEX_AUTH_THEME_RESET_STYLE')


def section_title(text):
    return paint(text, 'CODEX_AUTH_THEME_PROFILE_STYLE')


def money_per_day(total, days):
    if total is None:
        return 'n/a'
    return money(total / max(1, days))


def money_rate(value):
    if value is None:
        return 'n/a'
    if value == 0:
        return '$0.00'
    if abs(value) < 0.1:
        return f"${value:,.3f}".rstrip('0').rstrip('.')
    if abs(value) < 1:
        return f"${value:,.3f}".rstrip('0').rstrip('.')
    return f"${value:,.2f}"


def normalize_model(name):
    if not name:
        return None
    name = re.sub(r'\s+\(.*\)$', '', str(name).strip())
    return name or None


def parse_pricing_document(body):
    decoded = html.unescape(body)
    standard_markers = ['tier":[0,"standard"]', 'data-value="standard"']
    priority_markers = ['tier":[0,"priority"]', 'data-value="priority"']
    marker_mode = any(marker in decoded for marker in standard_markers)
    pattern = re.compile(r'\[\[0,"([^"]+)"\],\[0,([0-9.]+|"-")\],\[0,([0-9.]+|"-")\],\[0,([0-9.]+|"-")\]\]')
    models = {}
    for match in pattern.finditer(decoded):
        raw_name, input_rate, cached_input_rate, output_rate = match.groups()
        if marker_mode:
            match_pos = match.start()
            last_standard = max(decoded.rfind(marker, 0, match_pos) for marker in standard_markers)
            last_priority = max(decoded.rfind(marker, 0, match_pos) for marker in priority_markers)
            if last_standard == -1:
                continue
            if last_priority > last_standard:
                continue
        name = normalize_model(raw_name)
        if not name:
            continue
        if name in models:
            continue
        if input_rate == '"-"' or output_rate == '"-"':
            continue
        models[name] = {
            'input': float(input_rate),
            'cached_input': None if cached_input_rate == '"-"' else float(cached_input_rate),
            'output': float(output_rate),
        }
    fallback_model = 'gpt-5.4' if 'gpt-5.4' in models else next(iter(models.keys()), None)
    if not models or not fallback_model:
        raise ValueError('Unable to parse pricing models from pricing page')
    return {'models': models, 'fallback_model': fallback_model}


def load_cached_pricing():
    if not cache_path.exists():
        return None
    try:
        return json.loads(cache_path.read_text(encoding='utf-8'))
    except Exception:
        return None


def write_cached_pricing(data):
    try:
        cache_path.parent.mkdir(parents=True, exist_ok=True)
        cache_path.write_text(json.dumps(data, indent=2, sort_keys=True), encoding='utf-8')
    except Exception:
        pass


def fetch_pricing():
    req = urllib.request.Request(pricing_url, headers={'User-Agent': f'codex-auth/{os.environ.get("CODEX_AUTH_APP_VERSION", "0")}'} )
    with urllib.request.urlopen(req, timeout=8) as response:
        body = response.read().decode('utf-8', 'replace')
    parsed = parse_pricing_document(body)
    return {
        'cache_schema_version': 3,
        'fetched_at': now_utc.strftime('%Y-%m-%dT%H:%M:%SZ'),
        'source_url': pricing_url,
        'tier': 'standard',
        'fallback_model': parsed['fallback_model'],
        'models': parsed['models'],
    }


def get_pricing():
    ttl_seconds = int(pricing_ttl)
    cached = load_cached_pricing()
    if cached and (cached.get('cache_schema_version') != 3 or cached.get('tier') != 'standard'):
        cached = None
    cached_age = None
    if cached and cached.get('fetched_at'):
        try:
            cached_age = (now_utc - parse_dt(cached['fetched_at'])).total_seconds()
        except Exception:
            cached_age = None
    if cached and cached_age is not None and cached_age <= ttl_seconds:
        return cached, 'fresh-cache', None
    try:
        fresh = fetch_pricing()
        write_cached_pricing(fresh)
        return fresh, 'live-fetch', None
    except Exception as exc:
        if cached:
            return cached, 'stale-cache', str(exc)
        return None, 'unavailable', str(exc)


def cache_key(path):
    try:
        return path.relative_to(sessions_dir).as_posix()
    except Exception:
        return str(path)


def load_session_stats_cache():
    if force_recompute or not stats_cache_path.exists():
        return {'entries': {}}
    try:
        cached = json.loads(stats_cache_path.read_text(encoding='utf-8'))
    except Exception:
        return {'entries': {}}
    if cached.get('cache_schema_version') != 1:
        return {'entries': {}}
    cached_sessions_dir = cached.get('sessions_dir')
    if cached_sessions_dir and cached_sessions_dir != str(sessions_dir):
        return {'entries': {}}
    entries = cached.get('entries')
    if not isinstance(entries, dict):
        return {'entries': {}}
    return cached


def write_session_stats_cache(entries):
    try:
        stats_cache_path.parent.mkdir(parents=True, exist_ok=True)
        payload = {
            'cache_schema_version': 1,
            'generated_at': now_utc.strftime('%Y-%m-%dT%H:%M:%SZ'),
            'sessions_dir': str(sessions_dir),
            'entries': entries,
        }
        stats_cache_path.write_text(json.dumps(payload, indent=2, sort_keys=True), encoding='utf-8')
    except Exception:
        pass


def raw_event_to_runtime(raw):
    ts = parse_dt(raw.get('timestamp'))
    if ts is None:
        return None
    try:
        input_tokens = int(raw.get('input_tokens') or 0)
        cached_input_tokens = int(raw.get('cached_input_tokens') or 0)
        output_tokens = int(raw.get('output_tokens') or 0)
        reasoning_output_tokens = int(raw.get('reasoning_output_tokens') or 0)
        total_tokens_raw = raw.get('total_tokens')
        total_tokens = int(total_tokens_raw) if total_tokens_raw not in (None, '') else input_tokens + output_tokens
    except Exception:
        return None
    return {
        'timestamp': ts,
        'local_date': ts.astimezone(local_tz).date().isoformat(),
        'session_id': str(raw.get('session_id') or ''),
        'model': normalize_model(raw.get('model')),
        'input_tokens': input_tokens,
        'cached_input_tokens': cached_input_tokens,
        'output_tokens': output_tokens,
        'reasoning_output_tokens': reasoning_output_tokens,
        'total_tokens': total_tokens,
    }


def parse_events_from_path(path):
    raw_events = []
    current_model = None
    session_id = str(path)
    try:
        lines = path.read_text(encoding='utf-8', errors='replace').splitlines()
    except Exception:
        return raw_events
    for line in lines:
        try:
            obj = json.loads(line)
        except Exception:
            continue
        payload = obj.get('payload') if isinstance(obj.get('payload'), dict) else {}
        if obj.get('type') == 'session_meta':
            session_id = payload.get('id') or session_id
        elif obj.get('type') == 'turn_context':
            current_model = normalize_model(payload.get('model')) or current_model
        elif obj.get('type') == 'event_msg' and payload.get('type') == 'token_count':
            info = payload.get('info') or {}
            usage = info.get('last_token_usage') or {}
            if not usage:
                continue
            ts = parse_dt(obj.get('timestamp'))
            if ts is None:
                continue
            input_tokens = int(usage.get('input_tokens') or 0)
            cached_input_tokens = int(usage.get('cached_input_tokens') or 0)
            output_tokens = int(usage.get('output_tokens') or 0)
            reasoning_output_tokens = int(usage.get('reasoning_output_tokens') or 0)
            total_tokens = usage.get('total_tokens')
            total_tokens = int(total_tokens) if total_tokens not in (None, '') else input_tokens + output_tokens
            raw_events.append({
                'timestamp': ts.strftime('%Y-%m-%dT%H:%M:%SZ'),
                'session_id': session_id,
                'model': current_model,
                'input_tokens': input_tokens,
                'cached_input_tokens': cached_input_tokens,
                'output_tokens': output_tokens,
                'reasoning_output_tokens': reasoning_output_tokens,
                'total_tokens': total_tokens,
            })
    return raw_events


cache_stats = {'reused_files': 0, 'parsed_files': 0, 'path': str(stats_cache_path), 'forced': force_recompute}


def iter_events():
    if not sessions_dir.exists():
        return []
    cache = load_session_stats_cache()
    cached_entries = cache.get('entries', {})
    next_entries = {}
    events = []
    for path in sorted(sessions_dir.glob('**/rollout-*.jsonl')):
        try:
            stat = path.stat()
        except Exception:
            continue
        key = cache_key(path)
        entry = cached_entries.get(key) if isinstance(cached_entries, dict) else None
        raw_events = None
        if not force_recompute and isinstance(entry, dict) and entry.get('size') == stat.st_size and entry.get('mtime_ns') == stat.st_mtime_ns and isinstance(entry.get('events'), list):
            raw_events = entry.get('events') or []
            cache_stats['reused_files'] += 1
        else:
            raw_events = parse_events_from_path(path)
            cache_stats['parsed_files'] += 1
        next_entries[key] = {
            'size': stat.st_size,
            'mtime_ns': stat.st_mtime_ns,
            'events': raw_events,
        }
        for raw in raw_events:
            event = raw_event_to_runtime(raw)
            if event is not None:
                events.append(event)
    if force_recompute or cache_stats['parsed_files'] > 0 or set(next_entries.keys()) != set(cached_entries.keys()):
        write_session_stats_cache(next_entries)
    return events


events = iter_events()
if not events:
    if mode == 'footer':
        raise SystemExit(0)
    print(f"No session token history found in {sessions_dir}")
    raise SystemExit(1)

pricing, pricing_status, pricing_error = get_pricing()
pricing_models = pricing.get('models', {}) if pricing else {}
fallback_model = pricing.get('fallback_model') if pricing else None


def classify_window(event, period_key):
    event_local = event['timestamp'].astimezone(local_tz)
    event_date = event_local.date()
    now_date = now_local.date()
    if period_key == 'today':
        return event_date == now_date
    if period_key == '7d':
        return event_date >= now_date - dt.timedelta(days=6)
    if period_key == '14d':
        return event_date >= now_date - dt.timedelta(days=13)
    if period_key == '30d':
        return event_date >= now_date - dt.timedelta(days=29)
    if period_key == 'all':
        return True
    raise ValueError(f'Unknown period {period_key}')


def summarize(event_subset):
    sessions = set()
    active_days = set()
    totals = defaultdict(int)
    model_rows = {}
    exact_tokens = 0
    fallback_tokens = 0
    unpriced_tokens = 0
    cost_total = 0.0 if pricing else None
    for event in event_subset:
        sessions.add(event['session_id'])
        active_days.add(event['local_date'])
        for key in ('input_tokens', 'cached_input_tokens', 'output_tokens', 'reasoning_output_tokens', 'total_tokens'):
            totals[key] += int(event[key])
        model_key = event['model'] or 'unknown'
        row = model_rows.setdefault(model_key, {
            'model': model_key,
            'sessions': set(),
            'input_tokens': 0,
            'cached_input_tokens': 0,
            'output_tokens': 0,
            'reasoning_output_tokens': 0,
            'total_tokens': 0,
            'cost': 0.0,
            'cost_available': pricing is not None,
            'cost_mode': 'exact',
        })
        row['sessions'].add(event['session_id'])
        for key in ('input_tokens', 'cached_input_tokens', 'output_tokens', 'reasoning_output_tokens', 'total_tokens'):
            row[key] += int(event[key])
        if pricing:
            rates = pricing_models.get(event['model']) if event['model'] else None
            cost_mode = 'exact'
            if rates is None and fallback_model:
                rates = pricing_models.get(fallback_model)
                cost_mode = 'fallback'
            if rates is None:
                unpriced_tokens += int(event['total_tokens'])
                row['cost_available'] = False
                row['cost_mode'] = 'none'
            else:
                non_cached_input = max(0, int(event['input_tokens']) - int(event['cached_input_tokens']))
                cached_input = int(event['cached_input_tokens'])
                output = int(event['output_tokens'])
                cached_rate = rates['cached_input'] if rates.get('cached_input') is not None else rates['input']
                event_cost = ((non_cached_input * rates['input']) + (cached_input * cached_rate) + (output * rates['output'])) / 1_000_000.0
                cost_total += event_cost
                row['cost'] += event_cost
                if cost_mode == 'fallback':
                    row['cost_mode'] = 'fallback'
                    fallback_tokens += int(event['total_tokens'])
                else:
                    exact_tokens += int(event['total_tokens'])
        else:
            unpriced_tokens += int(event['total_tokens'])
            row['cost_available'] = False
            row['cost_mode'] = 'none'
    daily = {}
    for event in event_subset:
        row = daily.setdefault(event['local_date'], {'date': event['local_date'], 'sessions': set(), 'total_tokens': 0, 'cost': 0.0, 'cost_available': pricing is not None})
        row['sessions'].add(event['session_id'])
        row['total_tokens'] += int(event['total_tokens'])
        if pricing:
            rates = pricing_models.get(event['model']) if event['model'] else None
            if rates is None and fallback_model:
                rates = pricing_models.get(fallback_model)
            if rates is None:
                row['cost_available'] = False
            else:
                non_cached_input = max(0, int(event['input_tokens']) - int(event['cached_input_tokens']))
                cached_input = int(event['cached_input_tokens'])
                output = int(event['output_tokens'])
                cached_rate = rates['cached_input'] if rates.get('cached_input') is not None else rates['input']
                row['cost'] += ((non_cached_input * rates['input']) + (cached_input * cached_rate) + (output * rates['output'])) / 1_000_000.0
    daily_rows = [{'date': row['date'], 'sessions': len(row['sessions']), 'total_tokens': row['total_tokens'], 'cost': row['cost'] if row['cost_available'] else None} for row in daily.values()]
    daily_rows.sort(key=lambda item: item['date'], reverse=True)
    model_list = []
    for row in model_rows.values():
        model_list.append({
            'model': row['model'],
            'sessions': len(row['sessions']),
            'input_tokens': row['input_tokens'],
            'cached_input_tokens': row['cached_input_tokens'],
            'output_tokens': row['output_tokens'],
            'reasoning_output_tokens': row['reasoning_output_tokens'],
            'total_tokens': row['total_tokens'],
            'cost': row['cost'] if row['cost_available'] else None,
            'cost_mode': row['cost_mode'],
        })
    model_list.sort(key=lambda item: (-item['total_tokens'], item['model']))
    return {
        'sessions': len(sessions),
        'active_days': len(active_days),
        'input_tokens': totals['input_tokens'],
        'cached_input_tokens': totals['cached_input_tokens'],
        'output_tokens': totals['output_tokens'],
        'reasoning_output_tokens': totals['reasoning_output_tokens'],
        'total_tokens': totals['total_tokens'],
        'cost': cost_total if pricing else None,
        'daily_rows': daily_rows,
        'models': model_list,
        'exact_tokens': exact_tokens,
        'fallback_tokens': fallback_tokens,
        'unpriced_tokens': unpriced_tokens,
    }


period_order = ['today', '7d', '14d', '30d', 'all']
period_labels = {'today': 'Today', '7d': '7d', '14d': '14d', '30d': '30d'}
period_summaries = {period: summarize([event for event in events if classify_window(event, period)]) for period in period_order}
all_days = (now_local.date() - min(event['timestamp'].astimezone(local_tz).date() for event in events)).days + 1
period_labels['all'] = f'All ({all_days}d)'
period_day_lengths = {'today': 1, '7d': 7, '14d': 14, '30d': 30, 'all': all_days}
focus = focus_period if focus_period in period_order else '30d'
focus_summary = period_summaries[focus]
focus_daily_rows = focus_summary['daily_rows']
truncated_daily = False
if len(focus_daily_rows) > int(daily_limit):
    focus_daily_rows = focus_daily_rows[:int(daily_limit)]
    truncated_daily = True


def pad(value, width, align='left'):
    value = str(value)
    return value.rjust(width) if align == 'right' else value.ljust(width)


def render_table(headers, rows, aligns=None):
    aligns = aligns or ['left'] * len(headers)
    widths = [len(str(header)) for header in headers]
    for row in rows:
        for idx, value in enumerate(row):
            widths[idx] = max(widths[idx], len(str(value)))
    header_cells = [paint(pad(header, widths[idx], aligns[idx]), 'CODEX_AUTH_THEME_HEADER_STYLE') for idx, header in enumerate(headers)]
    separator_cells = [paint('─' * widths[idx], 'CODEX_AUTH_THEME_RESET_STYLE') for idx in range(len(headers))]
    lines = ['  '.join(header_cells), '  '.join(separator_cells)]
    for row in rows:
        cells = [pad(value, widths[idx], aligns[idx]) for idx, value in enumerate(row)]
        if cells:
            cells[0] = paint(cells[0], 'CODEX_AUTH_THEME_PROFILE_STYLE')
            row_label = str(row[0]).strip()
            if row_label == 'API-eq cost':
                cells = [paint(cell, 'CODEX_AUTH_THEME_COST_STYLE') for cell in cells]
            elif row_label == 'API-eq / day':
                cells = [paint(cell, 'CODEX_AUTH_THEME_RATE_STYLE') for cell in cells]
            else:
                last_header = str(headers[-1]).strip()
                if last_header == 'API-eq cost' and len(cells) == len(headers):
                    cells[-1] = paint(cells[-1], 'CODEX_AUTH_THEME_COST_STYLE')
        lines.append('  '.join(cells).rstrip())
    return '\n'.join(lines)


if mode == 'footer':
    today = period_summaries['today']
    week = period_summaries['7d']
    print('\n'.join([
        f"{paint('Session usage:', 'CODEX_AUTH_THEME_HEADER_STYLE')} today {today['sessions']} {session_label(today['sessions'])} · {human_tokens(today['total_tokens'])} tokens · {paint(money(today['cost']), 'CODEX_AUTH_THEME_COST_STYLE')} API-eq",
        f"{paint('Session usage:', 'CODEX_AUTH_THEME_HEADER_STYLE')} 7d    {week['sessions']} {session_label(week['sessions'])} · {human_tokens(week['total_tokens'])} tokens · {paint(money(week['cost']), 'CODEX_AUTH_THEME_COST_STYLE')} API-eq",
    ]))
    raise SystemExit(0)

summary_headers = ['Metric'] + [period_labels[key] for key in period_order]
summary_rows = []
metrics = [
    ('Sessions', lambda item: item['sessions']),
    ('Active days', lambda item: item['active_days']),
    ('Total tokens', lambda item: human_tokens(item['total_tokens'])),
    ('Input tokens', lambda item: human_tokens(item['input_tokens'])),
    ('Cached input', lambda item: human_tokens(item['cached_input_tokens'])),
    ('Output tokens', lambda item: human_tokens(item['output_tokens'])),
    ('Reasoning output', lambda item: human_tokens(item['reasoning_output_tokens'])),
    ('API-eq cost', lambda item: money(item['cost'])),
]
for label, getter in metrics:
    summary_rows.append([label] + [getter(period_summaries[key]) for key in period_order])
summary_rows.append(['API-eq / day'] + [money_per_day(period_summaries[key]['cost'], period_day_lengths[key]) for key in period_order])

print(section_rule())
print(paint(f"Session statistics ({'UTC' if use_utc == '1' else 'local time'})", 'CODEX_AUTH_THEME_HEADER_STYLE'))
print(paint(f"Parsed {len(events)} token_count events across {period_summaries['all']['sessions']} sessions from {sessions_dir}", 'CODEX_AUTH_THEME_DIM_STYLE'))
print(section_rule())
print()
print(section_title('Overview'))
print(render_table(summary_headers, summary_rows, ['left'] + ['right'] * (len(summary_headers) - 1)))
print()

daily_title = f"Daily activity ({focus if focus != 'all' else period_labels['all']})"
if truncated_daily:
    daily_title += f", latest {daily_limit} days shown"
print(section_rule())
print(section_title(daily_title))
daily_rows = [[row['date'], row['sessions'], human_tokens(row['total_tokens']), money(row['cost'])] for row in focus_daily_rows]
print(render_table(['Date', 'Sessions', 'Total tokens', 'API-eq cost'], daily_rows, ['left', 'right', 'right', 'right']))
print()

print(section_rule())
print(section_title(f"Model breakdown ({focus if focus != 'all' else period_labels['all']})"))
model_rows = []
for row in focus_summary['models']:
    model_name = row['model']
    if row['cost_mode'] == 'fallback' and model_name == 'unknown':
        model_name = 'unknown*'
    model_rows.append([
        model_name,
        row['sessions'],
        human_tokens(row['total_tokens']),
        human_tokens(row['input_tokens']),
        human_tokens(row['cached_input_tokens']),
        human_tokens(row['output_tokens']),
        human_tokens(row['reasoning_output_tokens']),
        money(row['cost']),
        pct(row['total_tokens'], focus_summary['total_tokens']),
    ])
print(render_table(['Model', 'Sessions', 'Total', 'Input', 'Cached', 'Output', 'Reasoning', 'API-eq cost', 'Share'], model_rows, ['left', 'right', 'right', 'right', 'right', 'right', 'right', 'right', 'right']))
print()

print(section_rule())
print(section_title(f"Pricing basis ({focus if focus != 'all' else period_labels['all']})"))
pricing_basis_rows = []
seen_basis = set()
for row in focus_summary['models']:
    model_key = row['model']
    rates_model = model_key if model_key in pricing_models else fallback_model if fallback_model in pricing_models else None
    if rates_model is None:
        continue
    display_name = model_key
    mode_label = 'exact'
    if model_key not in pricing_models:
        display_name = f"{model_key} → {fallback_model}"
        mode_label = 'fallback'
    if display_name in seen_basis:
        continue
    seen_basis.add(display_name)
    rates = pricing_models[rates_model]
    pricing_basis_rows.append([
        display_name,
        money_rate(rates['input']),
        money_rate(rates['cached_input'] if rates.get('cached_input') is not None else rates['input']),
        money_rate(rates['output']),
        mode_label,
    ])
if pricing_basis_rows:
    print(render_table(['Model basis', 'Input / 1M', 'Cached / 1M', 'Output / 1M', 'Mode'], pricing_basis_rows, ['left', 'right', 'right', 'right', 'left']))
    print()

notes = []
if pricing:
    notes.append(f"Pricing source: {pricing.get('source_url')} (cached {pricing.get('fetched_at')}, status: {pricing_status}, standard tier)")
    notes.append(f"Unknown-model events use fallback pricing from {fallback_model}")
    notes.append(f"Cost coverage: {pct(focus_summary['exact_tokens'], focus_summary['total_tokens'])} exact-model, {pct(focus_summary['fallback_tokens'], focus_summary['total_tokens'])} fallback-model")
else:
    notes.append(f"Pricing unavailable: {pricing_error or 'no pricing cache and live fetch failed'}")
notes.append(f"Stats cache: reused {cache_stats['reused_files']} rollout files, parsed {cache_stats['parsed_files']} rollout files{' (forced)' if cache_stats['forced'] else ''}; {cache_stats['path']}")
notes.append('Cost methodology: (input tokens - cached input tokens) × input rate + cached input tokens × cached-input rate + output tokens × output rate.')
notes.append('Cached input is included within input tokens.')
notes.append('Reasoning output is shown separately for visibility but is not charged again, because it is already included within output tokens in the session logs.')
print(section_rule())
print(section_title('Notes'))
for note in notes:
    print(paint(f"- {note}", 'CODEX_AUTH_THEME_DIM_STYLE'))
PY
}

stats_command() {
  local focus_period=30d
  local use_utc=0
  local force_recompute=0
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --utc)
        [[ $use_utc -eq 0 ]] || die "Usage: codex-auth stats [--utc] [--recompute] [--period <today|7d|14d|30d|all>]"
        use_utc=1
        ;;
      --recompute)
        [[ $force_recompute -eq 0 ]] || die "Usage: codex-auth stats [--utc] [--recompute] [--period <today|7d|14d|30d|all>]"
        force_recompute=1
        ;;
      --period)
        shift
        [[ $# -gt 0 ]] || die "Usage: codex-auth stats [--utc] [--recompute] [--period <today|7d|14d|30d|all>]"
        focus_period=$1
        ;;
      *)
        die "Usage: codex-auth stats [--utc] [--recompute] [--period <today|7d|14d|30d|all>]"
        ;;
    esac
    shift
  done
  case "$focus_period" in
    today|7d|14d|30d|all)
      ;;
    *)
      die "Usage: codex-auth stats [--utc] [--recompute] [--period <today|7d|14d|30d|all>]"
      ;;
  esac
  render_session_stats stats "$use_utc" "$focus_period" 31 "$force_recompute"
}

save_profile() {
  local profile_name=$1
  validate_profile_name "$profile_name"
  require_auth_file
  ensure_dirs
  local dir auth_copy meta_path
  dir=$(profile_dir "$profile_name")
  mkdir -p "$dir"
  auth_copy="$dir/auth.json"
  meta_path="$dir/meta.json"
  cp "$AUTH_FILE" "$auth_copy"
  write_meta_file "$profile_name" "$auth_copy" "$meta_path"
  write_current_profile_marker "$profile_name"
  best_effort_refresh_usage "$profile_name"
  note "Saved profile '$profile_name'"
}

list_profiles() {
  ensure_dirs
  local use_utc=${1:-0}
  local include_stats=${2:-0}
  local active_name names_found=0 name payload_file
  active_name=$(find_matching_profile || true)
  payload_file=$(mktemp)
  while IFS= read -r name; do
    [[ -n "$name" ]] || continue
    names_found=1
    profile_display_payload_json "$name" "$(profile_meta_path "$name")" "$(profile_usage_path "$name")" "$active_name" "$use_utc" >> "$payload_file"
  done < <(list_profile_names)
  if [[ $names_found -eq 1 ]]; then
    render_profile_table "$payload_file"
    if [[ $include_stats -eq 1 ]]; then
      render_session_stats footer "$use_utc" 30d 31 0 || true
    fi
  else
    note "No saved profiles in $PROFILES_DIR"
  fi
  rm -f "$payload_file"
}

show_current() {
  ensure_dirs
  require_auth_file
  local use_utc=${1:-0}
  local matched
  matched=$(find_matching_profile || true)
  if [[ -n "$matched" ]]; then
    render_profile_line "$matched" "$matched" "$use_utc"
    return 0
  fi

  local tmp_meta
  tmp_meta=$(mktemp)
  extract_meta_json "untracked" "$AUTH_FILE" > "$tmp_meta"
  python3 - "$tmp_meta" "$use_utc" <<'PY'
import datetime as dt
import json
import sys

meta = json.load(open(sys.argv[1]))
use_utc = sys.argv[2] == '1'
local_tz = dt.datetime.now().astimezone().tzinfo or dt.timezone.utc


def format_datetime(value):
    if not value:
        return None
    text = str(value).strip()
    if text.endswith('Z'):
        text = text[:-1] + '+00:00'
    try:
        parsed = dt.datetime.fromisoformat(text)
    except ValueError:
        return value
    if parsed.tzinfo is None:
        parsed = parsed.replace(tzinfo=dt.timezone.utc)
    if use_utc:
        return parsed.astimezone(dt.timezone.utc).strftime('%Y-%m-%d %H:%MZ')
    localized = parsed.astimezone(local_tz)
    return localized.strftime('%d %b %H:%M ') + (localized.tzname() or 'UTC')

parts = ['* untracked']
parts.append(meta.get('email') or 'unknown-email')
parts.append(f"account={meta.get('accountId') or 'unknown-account'}")
if meta.get('tokenExpiresAt'):
    parts.append(f"expires={format_datetime(meta['tokenExpiresAt'])}")
if meta.get('lastRefresh'):
    parts.append(f"last_refresh={format_datetime(meta['lastRefresh'])}")
print(' | '.join(parts))
PY
  rm -f "$tmp_meta"
}

choose_profile_interactive() {
  local active_name=${1:-}
  local entries_file use_fzf=0 name
  entries_file=$(mktemp)
  printf $'PROFILE\t  PROFILE                   EMAIL                             5H      WEEKLY\n' > "$entries_file"
  while IFS= read -r name; do
    [[ -n "$name" ]] || continue
    profile_switch_row_tsv "$name" "$active_name" >> "$entries_file"
  done < <(list_profile_names)
  [[ $(wc -l < "$entries_file") -gt 1 ]] || die "No saved profiles to select"

  if command -v fzf >/dev/null 2>&1; then
    if [[ "${CODEX_AUTH_FORCE_FZF:-0}" == "1" ]] || [[ -t 0 ]] || [[ -r /dev/tty ]]; then
      use_fzf=1
    fi
  fi

  if [[ $use_fzf -eq 1 ]]; then
    local selected
    local -a fzf_opts
    fzf_opts=(--delimiter=$'\t' --with-nth=2 --header-lines=1 --prompt='Switch to profile> ' --layout=reverse --border)
    if [[ -n "${CODEX_AUTH_FZF_FILTER:-}" ]]; then
      fzf_opts+=(--filter="$CODEX_AUTH_FZF_FILTER")
    fi
    if [[ -n "${TMUX:-}" ]] && ( [[ -t 0 ]] || [[ -r /dev/tty ]] ) && command -v fzf-tmux >/dev/null 2>&1; then
      selected=$(fzf-tmux -p 80%,70% "${fzf_opts[@]}" < "$entries_file" || true)
    else
      fzf_opts+=(--height=80%)
      selected=$(fzf "${fzf_opts[@]}" < "$entries_file" || true)
    fi
    [[ -n "$selected" ]] || die "No profile selected"
    rm -f "$entries_file"
    printf '%s\n' "$selected" | cut -f1
    return 0
  fi

  local options=() i=1 choice display profile
  echo "Select a profile:" >&2
  while IFS=$'\t' read -r profile display; do
    [[ "$profile" == "PROFILE" ]] && continue
    options+=("$profile")
    printf '  %d) %s\n' "$i" "$display" >&2
    i=$((i + 1))
  done < "$entries_file"
  read -r -p 'Enter number: ' choice
  [[ "$choice" =~ ^[0-9]+$ ]] || die "Invalid selection"
  (( choice >= 1 && choice <= ${#options[@]} )) || die "Selection out of range"
  rm -f "$entries_file"
  printf '%s\n' "${options[choice-1]}"
}

switch_profile() {
  ensure_dirs
  local target=${1:-}
  local active_name
  active_name=$(find_matching_profile || true)
  if [[ -z "$target" ]]; then
    target=$(choose_profile_interactive "$active_name")
  fi
  validate_profile_name "$target"
  local dir src
  dir=$(profile_dir "$target")
  [[ -d "$dir" ]] || die "Unknown profile '$target'"
  src="$dir/auth.json"
  [[ -f "$src" ]] || die "Profile '$target' is missing auth.json"

  # Pre-switch: save live auth.json back to the outgoing profile snapshot
  if [[ -f "$CURRENT_PROFILE_FILE" ]]; then
    local current_name
    current_name=$(cat "$CURRENT_PROFILE_FILE")
    if [[ -n "$current_name" && -d "$(profile_dir "$current_name")" && -f "$AUTH_FILE" ]]; then
      local outgoing_auth_path outgoing_meta_path
      outgoing_auth_path=$(profile_auth_path "$current_name")
      outgoing_meta_path=$(profile_meta_path "$current_name")
      # Only overwrite the outgoing snapshot when the live auth.json
      # verifiably belongs to that profile's account; skip silently otherwise
      # (e.g. after a manual codex login to a different account).
      if live_auth_matches_profile "$AUTH_FILE" "$outgoing_meta_path"; then
        cp "$AUTH_FILE" "$outgoing_auth_path"
        write_meta_file "$current_name" "$outgoing_auth_path" "$outgoing_meta_path"
      fi
    fi
  fi

  cp "$src" "$AUTH_FILE"
  write_current_profile_marker "$target"
  note "Switched to '$target'"
  render_profile_line "$target" "$target"
}

add_profile() {
  local profile_name=$1
  validate_profile_name "$profile_name"
  ensure_dirs
  note "Starting codex login for profile '$profile_name'..."
  codex login
  codex login status >/dev/null 2>&1 || die "codex login did not complete successfully"
  require_auth_file
  save_profile "$profile_name"
  render_profile_line "$profile_name" "$profile_name"
}

rename_profile() {
  local old_name=$1
  local new_name=$2
  validate_profile_name "$old_name"
  validate_profile_name "$new_name"
  local old_dir new_dir
  old_dir=$(profile_dir "$old_name")
  new_dir=$(profile_dir "$new_name")
  [[ -d "$old_dir" ]] || die "Unknown profile '$old_name'"
  [[ ! -e "$new_dir" ]] || die "Profile '$new_name' already exists"
  mv "$old_dir" "$new_dir"
  if [[ -f "$CURRENT_PROFILE_FILE" ]] && [[ "$(cat "$CURRENT_PROFILE_FILE")" == "$old_name" ]]; then
    write_current_profile_marker "$new_name"
  fi
  local auth_path meta_path
  auth_path=$(profile_auth_path "$new_name")
  meta_path=$(profile_meta_path "$new_name")
  [[ -f "$auth_path" ]] && write_meta_file "$new_name" "$auth_path" "$meta_path"
  note "Renamed '$old_name' to '$new_name'"
}

remove_profile() {
  local profile_name=$1
  validate_profile_name "$profile_name"
  local dir
  dir=$(profile_dir "$profile_name")
  [[ -d "$dir" ]] || die "Unknown profile '$profile_name'"
  rm -rf "$dir"
  clear_current_profile_marker_if_matches "$profile_name"
  note "Removed '$profile_name'"
}

refresh_usage_command() {
  ensure_dirs
  local target=${1:-}
  local use_utc=${2:-0}
  local include_stats=${3:-0}
  local name error
  local index=0 total=0 failure_count=0
  local -a targets=()
  [[ -n "$target" ]] || target="--all"

  while IFS= read -r name; do
    [[ -n "$name" ]] || continue
    targets+=("$name")
  done < <(collect_refresh_targets "$target")

  total=${#targets[@]}
  (( total > 0 )) || die "No saved profiles to refresh"

  for name in "${targets[@]}"; do
    index=$((index + 1))
    refresh_progress_begin "$index" "$total" "$name"
    error=""
    if error=$(refresh_usage_for_profile "$name"); then
      refresh_progress_finish "$index" "$total" "$name" "ok"
      continue
    fi
    failure_count=$((failure_count + 1))
    refresh_progress_finish "$index" "$total" "$name" "fail" "$error"
  done

  refresh_progress_clear
  list_profiles "$use_utc" "$include_stats"

  if (( failure_count > 0 )); then
    note "To repair a profile token, run: codex-auth switch <profile> && codex logout && codex login && codex-auth save <profile>"
    return 1
  fi
  return 0
}

token_status_payload_json() {
  local profile_name=$1
  local auth_path=$2
  local use_utc=${3:-0}
  local active_name=${4:-}
  python3 - "$profile_name" "$auth_path" "$use_utc" "$active_name" <<'PY'
import base64
import datetime as dt
import json
import sys
from pathlib import Path

profile_name, auth_path, use_utc, active_name = sys.argv[1:5]
use_utc = use_utc == '1'
obj = json.loads(Path(auth_path).read_text())
tokens = obj.get('tokens') or {}
local_tz = dt.datetime.now().astimezone().tzinfo or dt.timezone.utc

def claims(token):
    if not isinstance(token, str) or '.' not in token:
        return {}
    parts = token.split('.')
    if len(parts) < 2 or not parts[1]:
        return {}
    payload = parts[1] + '=' * (-len(parts[1]) % 4)
    try:
        return json.loads(base64.urlsafe_b64decode(payload.encode()).decode())
    except Exception:
        return {}

def iso_from_epoch(value):
    if value is None:
        return None
    try:
        return dt.datetime.fromtimestamp(int(value), tz=dt.timezone.utc).strftime('%Y-%m-%dT%H:%M:%SZ')
    except Exception:
        return None

def format_epoch(value):
    if value is None:
        return 'unknown'
    try:
        parsed = dt.datetime.fromtimestamp(int(value), tz=dt.timezone.utc)
    except Exception:
        return str(value)
    if use_utc:
        return parsed.astimezone(dt.timezone.utc).strftime('%Y-%m-%d %H:%MZ')
    localized = parsed.astimezone(local_tz)
    return localized.strftime('%d %b %H:%M ') + (localized.tzname() or 'UTC')

def format_datetime_text(value):
    if not value:
        return ''
    text = str(value).strip()
    if text.endswith('Z'):
        text = text[:-1] + '+00:00'
    try:
        parsed = dt.datetime.fromisoformat(text)
    except ValueError:
        return str(value)
    if parsed.tzinfo is None:
        parsed = parsed.replace(tzinfo=dt.timezone.utc)
    if use_utc:
        return parsed.astimezone(dt.timezone.utc).strftime('%Y-%m-%d %H:%MZ')
    localized = parsed.astimezone(local_tz)
    return localized.strftime('%d %b %H:%M ') + (localized.tzname() or 'UTC')

def status(value):
    if value is None:
        return 'unknown'
    try:
        expires = dt.datetime.fromtimestamp(int(value), tz=dt.timezone.utc)
    except Exception:
        return 'unknown'
    return 'expired' if expires <= dt.datetime.now(dt.timezone.utc) else 'valid'

id_claims = claims(tokens.get('id_token'))
access_claims = claims(tokens.get('access_token'))
payload = {
    'profile': profile_name,
    'active': profile_name == active_name,
    'email': id_claims.get('email') or access_claims.get('email') or 'unknown-email',
    'account': tokens.get('account_id') or 'unknown-account',
    'auth_provider': id_claims.get('auth_provider') or access_claims.get('auth_provider') or '',
    'id_token': format_epoch(id_claims.get('exp')),
    'id_status': status(id_claims.get('exp')),
    'access_token': format_epoch(access_claims.get('exp')),
    'access_status': status(access_claims.get('exp')),
    'last_refresh': format_datetime_text(obj.get('last_refresh')),
    'refresh': 'yes' if tokens.get('refresh_token') else 'no',
    'id_token_expires_at': iso_from_epoch(id_claims.get('exp')),
    'access_token_expires_at': iso_from_epoch(access_claims.get('exp')),
}
print(json.dumps(payload, sort_keys=True))
PY
}

render_token_status_table() {
  local payload_file=$1
  python3 - "$payload_file" <<'PY'
import json
import os
import sys
from pathlib import Path

rows = [json.loads(line) for line in Path(sys.argv[1]).read_text().splitlines() if line.strip()]
headers = ['PROFILE', 'EMAIL', 'ACCOUNT', 'ID TOKEN', 'ACCESS TOKEN', 'REFRESH', 'LAST REFRESH']

def color_enabled():
    return os.environ.get('CODEX_AUTH_FORCE_COLOR') == '1' or (
        os.environ.get('NO_COLOR') is None
        and sys.stdout.isatty()
        and os.environ.get('TERM', '') not in ('', 'dumb')
    )

USE_COLOR = color_enabled()

def paint(value, env_name):
    if not USE_COLOR:
        return str(value)
    style = os.environ.get(env_name, '')
    return f"\033[{style}m{value}\033[0m" if style else str(value)

def status_style(status):
    if status == 'valid':
        return 'CODEX_AUTH_THEME_PERCENT_OK_STYLE'
    if status == 'expired':
        return 'CODEX_AUTH_THEME_PERCENT_BAD_STYLE'
    return 'CODEX_AUTH_THEME_DIM_STYLE'

plain_values = []
colored_values = []
for row in rows:
    active = bool(row.get('active'))
    profile_plain = ('* ' if active else '  ') + (row.get('profile') or '')
    id_plain = f"{row.get('id_status')} {row.get('id_token')}"
    access_plain = f"{row.get('access_status')} {row.get('access_token')}"
    refresh_plain = f"refresh={row.get('refresh') or 'no'}"
    plain = [
        profile_plain,
        row.get('email') or '',
        row.get('account') or '',
        id_plain,
        access_plain,
        refresh_plain,
        row.get('last_refresh') or '',
    ]
    marker = paint('*', 'CODEX_AUTH_THEME_ACTIVE_STYLE') if active else ' '
    profile = paint(row.get('profile') or '', 'CODEX_AUTH_THEME_PROFILE_STYLE')
    refresh_style = 'CODEX_AUTH_THEME_PERCENT_OK_STYLE' if row.get('refresh') == 'yes' else 'CODEX_AUTH_THEME_PERCENT_BAD_STYLE'
    colored = [
        f"{marker} {profile}",
        row.get('email') or '',
        paint(row.get('account') or '', 'CODEX_AUTH_THEME_DIM_STYLE'),
        paint(id_plain, status_style(row.get('id_status'))),
        paint(access_plain, status_style(row.get('access_status'))),
        paint(refresh_plain, refresh_style),
        paint(row.get('last_refresh') or '', 'CODEX_AUTH_THEME_DIM_STYLE'),
    ]
    plain_values.append(plain)
    colored_values.append(colored)
widths = [len(item) for item in headers]
for row in plain_values:
    for index, item in enumerate(row):
        widths[index] = max(widths[index], len(str(item)))

def pad(value, width):
    return str(value) + (' ' * max(0, width - len(str(value))))

print('  '.join(paint(pad(header, widths[index]), 'CODEX_AUTH_THEME_HEADER_STYLE') for index, header in enumerate(headers)).rstrip())
for plain, colored in zip(plain_values, colored_values):
    cells = []
    for index, value in enumerate(colored):
        suffix = ' ' * max(0, widths[index] - len(str(plain[index])))
        cells.append(str(value) + suffix)
    print('  '.join(cells).rstrip())
PY
}

token_status_command() {
  ensure_dirs
  local target=${1:-}
  local use_utc=${2:-0}
  local payload_file name active_name
  payload_file=$(mktemp)
  active_name=$(find_matching_profile || true)
  [[ -n "$target" ]] || target="--all"
  if [[ "$target" == "--all" ]]; then
    while IFS= read -r name; do
      [[ -n "$name" ]] || continue
      token_status_payload_json "$name" "$(profile_auth_path "$name")" "$use_utc" "$active_name" >> "$payload_file"
    done < <(list_profile_names)
  else
    validate_profile_name "$target"
    [[ -d "$(profile_dir "$target")" ]] || die "Unknown profile '$target'"
    token_status_payload_json "$target" "$(profile_auth_path "$target")" "$use_utc" "$active_name" >> "$payload_file"
  fi
  if [[ -s "$payload_file" ]]; then
    render_token_status_table "$payload_file"
  else
    note "No saved profiles in $PROFILES_DIR"
  fi
  rm -f "$payload_file"
}

sync_live_auth_to_profile_snapshot() {
  local profile_name=$1
  validate_profile_name "$profile_name"
  require_auth_file
  local auth_path meta_path
  auth_path=$(profile_auth_path "$profile_name")
  meta_path=$(profile_meta_path "$profile_name")
  [[ -d "$(profile_dir "$profile_name")" ]] || die "Unknown profile '$profile_name'"
  cp "$AUTH_FILE" "$auth_path"
  write_meta_file "$profile_name" "$auth_path" "$meta_path"
}

report_touch_token_change() {
  local profile_name=$1
  local before_path=$2
  local after_path=$3
  python3 - "$profile_name" "$before_path" "$after_path" <<'PY'
import hashlib
import json
import sys
from pathlib import Path

profile_name, before_path, after_path = sys.argv[1:4]

def load(path):
    try:
        return json.loads(Path(path).read_text())
    except Exception:
        return {}

def digest(value):
    if not value:
        return ''
    return hashlib.sha256(str(value).encode()).hexdigest()

before = load(before_path)
after = load(after_path)
before_tokens = before.get('tokens') or {}
after_tokens = after.get('tokens') or {}

id_changed = digest(before_tokens.get('id_token')) != digest(after_tokens.get('id_token'))
access_changed = digest(before_tokens.get('access_token')) != digest(after_tokens.get('access_token'))
last_refresh_changed = before.get('last_refresh') != after.get('last_refresh')

if id_changed or access_changed:
    changed = []
    if id_changed:
        changed.append('ID token')
    if access_changed:
        changed.append('access token')
    print(f"Tokens refreshed for '{profile_name}' ({', '.join(changed)} changed)")
elif last_refresh_changed:
    print(f"Auth metadata updated for '{profile_name}', but ID/access tokens are unchanged")
else:
    print(f"Tokens unchanged for '{profile_name}' (Codex did not rotate tokens during this run)")
PY
}

touch_one_profile() {
  local profile_name=$1
  validate_profile_name "$profile_name"
  [[ -d "$(profile_dir "$profile_name")" ]] || die "Unknown profile '$profile_name'"
  local tmp_dir codex_output before_auth status=0
  note "Touching $profile_name"
  before_auth=$(mktemp)
  cp "$(profile_auth_path "$profile_name")" "$before_auth"
  switch_profile "$profile_name" >/dev/null 2>&1
  tmp_dir=$(mktemp -d)
  codex_output=$(mktemp)
  if "$CODEX_AUTH_CODEX_BIN" exec \
    --ephemeral \
    --ignore-user-config \
    --ignore-rules \
    --skip-git-repo-check \
    --sandbox read-only \
    -C "$tmp_dir" \
    'Reply with exactly: hi' >"$codex_output" 2>&1; then
    sync_live_auth_to_profile_snapshot "$profile_name"
    report_touch_token_change "$profile_name" "$before_auth" "$(profile_auth_path "$profile_name")" >&2
  else
    status=$?
    cat "$codex_output" >&2
  fi
  rm -f "$codex_output" "$before_auth"
  rm -rf "$tmp_dir"
  return "$status"
}

touch_command() {
  ensure_dirs
  local target=${1:-}
  [[ -n "$target" ]] || die "Usage: codex-auth touch <name>|--all"
  local -a targets=()
  local name
  if [[ "$target" == "--all" ]]; then
    while IFS= read -r name; do
      [[ -n "$name" ]] || continue
      targets+=("$name")
    done < <(list_profile_names)
  else
    validate_profile_name "$target"
    [[ -d "$(profile_dir "$target")" ]] || die "Unknown profile '$target'"
    targets+=("$target")
  fi
  (( ${#targets[@]} > 0 )) || die "No saved profiles to touch"
  for name in "${targets[@]}"; do
    [[ -f "$(profile_auth_path "$name")" ]] || die "Profile '$name' is missing auth.json"
  done
  require_cmd "$CODEX_AUTH_CODEX_BIN"

  local touch_lock_dir="$ACCOUNTS_DIR/touch.lock"
  if ! mkdir "$touch_lock_dir" 2>/dev/null; then
    die "Another codex-auth touch operation is already running (lock: $touch_lock_dir)"
  fi

  local original_name=""
  original_name=$(find_matching_profile || true)
  local original_auth_backup original_marker_backup had_auth=0 had_marker=0
  original_auth_backup=$(mktemp)
  original_marker_backup=$(mktemp)
  if [[ -f "$AUTH_FILE" ]]; then
    cp "$AUTH_FILE" "$original_auth_backup"
    had_auth=1
  fi
  if [[ -f "$CURRENT_PROFILE_FILE" ]]; then
    cp "$CURRENT_PROFILE_FILE" "$original_marker_backup"
    had_marker=1
  fi

  local failure_count=0
  for name in "${targets[@]}"; do
    if touch_one_profile "$name"; then
      note "Touched '$name'"
    else
      failure_count=$((failure_count + 1))
      note "Touch failed for '$name'"
    fi
  done

  if [[ -n "$original_name" && -d "$(profile_dir "$original_name")" ]]; then
    switch_profile "$original_name" >/dev/null 2>&1
    note "Restored profile '$original_name'"
  else
    if [[ $had_auth -eq 1 ]]; then
      mkdir -p "$CODEX_HOME"
      cp "$original_auth_backup" "$AUTH_FILE"
    fi
    if [[ $had_marker -eq 1 ]]; then
      mkdir -p "$ACCOUNTS_DIR"
      cp "$original_marker_backup" "$CURRENT_PROFILE_FILE"
    else
      rm -f "$CURRENT_PROFILE_FILE"
    fi
    note "Restored original Codex auth state"
  fi
  rm -f "$original_auth_backup" "$original_marker_backup"
  rm -rf "$touch_lock_dir"

  (( failure_count == 0 ))
}

resolve_current_executable_path() {
  local script_ref=${1:-${BASH_SOURCE[0]:-$0}}
  python3 - "$script_ref" <<'PY'
import os
import shutil
import sys

script_ref = sys.argv[1]
if "/" not in script_ref:
    resolved = shutil.which(script_ref)
else:
    resolved = script_ref

if not resolved:
    raise SystemExit(1)

print(os.path.realpath(resolved))
PY
}

shell_quote() {
  python3 - "$1" <<'PY'
import shlex
import sys

print(shlex.quote(sys.argv[1]))
PY
}

cron_usage() {
  cat <<USAGE
Usage: codex-auth cron [list|setup|add|delete|run]

Manage scheduled codex-auth touch cron jobs.

Commands:
  cron                         List codex-auth-managed touch cron jobs
  cron list                    List codex-auth-managed touch cron jobs
  cron setup                   Interactive wizard to create a touch cron job
  cron add [options]           Add a touch cron job non-interactively
  cron delete [<job-id>|--all] [--yes]
                               Delete managed touch cron job(s)
  cron run <job-id> <profile|--all>
                               Internal cron runner with timestamped output

Add options:
  --time HH:MM                 24-hour time for daily schedules
  --daily                      Run every day (default)
  --schedule "M H DOM MON DOW" Use a custom five-field cron schedule
  --all                        Touch all profiles (default)
  --profile <name>             Touch one saved profile
  --id <job-id>                Use an explicit managed job id
  --yes, -y                    Skip confirmation
USAGE
}

cron_read_current() {
  if [[ -n "${CODEX_AUTH_CRONTAB_FILE:-}" ]]; then
    [[ -f "$CODEX_AUTH_CRONTAB_FILE" ]] && cat "$CODEX_AUTH_CRONTAB_FILE"
    return 0
  fi

  require_cmd crontab
  local out_file err_file status=0
  out_file=$(mktemp)
  err_file=$(mktemp)
  if crontab -l >"$out_file" 2>"$err_file"; then
    cat "$out_file"
  else
    status=$?
    if grep -qi 'no crontab' "$err_file" || { [[ ! -s "$out_file" ]] && [[ ! -s "$err_file" ]]; }; then
      :
    else
      cat "$err_file" >&2
      rm -f "$out_file" "$err_file"
      return "$status"
    fi
  fi
  rm -f "$out_file" "$err_file"
}

cron_install_file() {
  local source_file=$1
  if [[ -n "${CODEX_AUTH_CRONTAB_FILE:-}" ]]; then
    cp "$source_file" "$CODEX_AUTH_CRONTAB_FILE"
    return 0
  fi
  require_cmd crontab
  crontab "$source_file"
}

cron_with_lock() {
  ensure_dirs
  local lock_dir="$ACCOUNTS_DIR/cron.lock"
  if ! mkdir "$lock_dir" 2>/dev/null; then
    die "Another codex-auth cron operation is already running (lock: $lock_dir)"
  fi
  local status=0
  set +e
  ( set -e; "$@" )
  status=$?
  set -e
  rm -rf "$lock_dir"
  return "$status"
}

cron_jobs_json_from_file() {
  local crontab_file=$1
  python3 - "$crontab_file" <<'PY'
import json
import re
import sys
from pathlib import Path

path = Path(sys.argv[1])
lines = path.read_text(encoding='utf-8').splitlines() if path.exists() else []
jobs = []
current = None

for line in lines:
    begin = re.match(r'^# BEGIN codex-auth touch ([A-Za-z0-9._-]+)\s*$', line)
    if begin:
        current = {
            'id': begin.group(1),
            'schedule': '',
            'target': '',
            'log': '',
            'cron': '',
            'command': '',
        }
        continue

    if current is None:
        continue

    end = re.match(r'^# END codex-auth touch ([A-Za-z0-9._-]+)\s*$', line)
    if end:
        if end.group(1) == current['id']:
            jobs.append(current)
        current = None
        continue

    stripped = line.strip()
    if stripped.startswith('# schedule:'):
        current['schedule'] = stripped.split(':', 1)[1].strip()
    elif stripped.startswith('# target:'):
        current['target'] = stripped.split(':', 1)[1].strip()
    elif stripped.startswith('# log:'):
        current['log'] = stripped.split(':', 1)[1].strip()
    elif stripped and not stripped.startswith('#'):
        parts = stripped.split(None, 5)
        if len(parts) >= 6:
            current['cron'] = ' '.join(parts[:5])
            current['command'] = parts[5]

for job in jobs:
    print(json.dumps(job, separators=(',', ':')))
PY
}

render_cron_jobs_table() {
  local jobs_file=$1
  local color_enabled=0
  if color_output_enabled; then
    color_enabled=1
  fi

  python3 - "$jobs_file" "$color_enabled" <<'PY'
import json
import os
import sys
from pathlib import Path

rows = []
for line in Path(sys.argv[1]).read_text(encoding='utf-8').splitlines():
    line = line.strip()
    if line:
        rows.append(json.loads(line))

color_enabled = sys.argv[2] == '1'


def paint(text, style_name):
    if not text or not color_enabled:
        return text
    style = os.environ.get(style_name, '')
    return f"\033[{style}m{text}\033[0m" if style else text


if not rows:
    print("No codex-auth touch cron jobs found.")
    print("Run: codex-auth cron setup")
    raise SystemExit(0)

print(paint("CODEX-AUTH TOUCH CRON JOBS", 'CODEX_AUTH_THEME_HEADER_STYLE'))
headers = ['ID', 'SCHEDULE', 'TARGET', 'CRON', 'LOG']
display_rows = []
for row in rows:
    target = row.get('target') or ''
    if target == '--all':
        target = 'all profiles'
    display_rows.append([
        row.get('id') or '',
        row.get('schedule') or '',
        target,
        row.get('cron') or '',
        row.get('log') or '',
    ])

widths = []
for index, header in enumerate(headers):
    widths.append(max([len(header)] + [len(row[index]) for row in display_rows]))


def pad(value, width):
    return (value or '').ljust(width)


header_line = '  '.join(paint(pad(header, width), 'CODEX_AUTH_THEME_HEADER_STYLE') for header, width in zip(headers, widths))
print(header_line)
for row in display_rows:
    cells = [
        paint(pad(row[0], widths[0]), 'CODEX_AUTH_THEME_PROFILE_STYLE'),
        paint(pad(row[1], widths[1]), 'CODEX_AUTH_THEME_RESET_STYLE'),
        pad(row[2], widths[2]),
        pad(row[3], widths[3]),
        paint(pad(row[4], widths[4]), 'CODEX_AUTH_THEME_DIM_STYLE'),
    ]
    print('  '.join(cells))
PY
}

cron_list_command() {
  local crontab_file jobs_file
  crontab_file=$(mktemp)
  jobs_file=$(mktemp)
  cron_read_current > "$crontab_file"
  cron_jobs_json_from_file "$crontab_file" > "$jobs_file"
  render_cron_jobs_table "$jobs_file"
  rm -f "$crontab_file" "$jobs_file"
}

cron_job_tsv_from_file() {
  local crontab_file=$1
  local jobs_file
  jobs_file=$(mktemp)
  cron_jobs_json_from_file "$crontab_file" > "$jobs_file"
  python3 - "$jobs_file" <<'PY'
import json
import sys
from pathlib import Path

print("ID\t  ID                         SCHEDULE                  TARGET")
for line in Path(sys.argv[1]).read_text(encoding='utf-8').splitlines():
    if not line.strip():
        continue
    job = json.loads(line)
    target = 'all profiles' if job.get('target') == '--all' else job.get('target', '')
    display = f"  {job.get('id',''):<26} {job.get('schedule',''):<25} {target}"
    print(f"{job.get('id','')}\t{display}")
PY
  rm -f "$jobs_file"
}

cron_has_job_id() {
  local crontab_file=$1
  local job_id=$2
  grep -Fxq "# BEGIN codex-auth touch $job_id" "$crontab_file"
}

cron_slug() {
  python3 - "$1" <<'PY'
import re
import sys

text = sys.argv[1].strip().lower()
text = re.sub(r'[^a-z0-9._-]+', '-', text)
text = text.strip('-')
print(text or 'job')
PY
}

validate_cron_job_id() {
  local job_id=${1:-}
  [[ -n "$job_id" ]] || die "Cron job id is required"
  [[ "$job_id" =~ ^[A-Za-z0-9._-]+$ ]] || die "Invalid cron job id '$job_id' (allowed: letters, numbers, dot, underscore, hyphen)"
}

validate_cron_time() {
  local time_value=${1:-}
  [[ "$time_value" =~ ^([01][0-9]|2[0-3]):[0-5][0-9]$ ]] || die "Invalid time '$time_value' (expected HH:MM, 24-hour)"
}

validate_cron_expression() {
  local expression=${1:-}
  python3 - "$expression" <<'PY'
import sys

parts = sys.argv[1].split()
if len(parts) != 5:
    raise SystemExit(1)
if any(part.strip() == '' for part in parts):
    raise SystemExit(1)
PY
}

cron_expr_from_time() {
  local schedule_type=$1
  local time_value=$2
  validate_cron_time "$time_value"
  local hour minute
  hour=${time_value%:*}
  minute=${time_value#*:}
  # Strip leading zeroes for readability; force decimal with 10#.
  hour=$((10#$hour))
  minute=$((10#$minute))
  case "$schedule_type" in
    daily)
      printf '%s %s * * *\n' "$minute" "$hour"
      ;;
    *)
      die "Unknown cron schedule type '$schedule_type'"
      ;;
  esac
}

cron_schedule_description() {
  local schedule_type=$1
  local time_value=${2:-}
  local expression=${3:-}
  case "$schedule_type" in
    daily)
      printf 'daily at %s\n' "$time_value"
      ;;
    custom)
      printf 'custom: %s\n' "$expression"
      ;;
    *)
      die "Unknown cron schedule type '$schedule_type'"
      ;;
  esac
}

cron_default_job_id_base() {
  local schedule_type=$1
  local time_value=${2:-}
  local target=$3
  local target_slug
  if [[ "$target" == "--all" ]]; then
    target_slug="all"
  else
    target_slug=$(cron_slug "$target")
  fi
  case "$schedule_type" in
    daily)
      printf '%s-%s-%s\n' "$schedule_type" "${time_value/:/}" "$target_slug"
      ;;
    custom)
      printf 'custom-%s\n' "$target_slug"
      ;;
    *)
      die "Unknown cron schedule type '$schedule_type'"
      ;;
  esac
}

cron_unique_job_id() {
  local crontab_file=$1
  local base_id=$2
  local candidate=$base_id
  local suffix=2
  while cron_has_job_id "$crontab_file" "$candidate"; do
    candidate="${base_id}-${suffix}"
    suffix=$((suffix + 1))
  done
  printf '%s\n' "$candidate"
}

cron_validate_target() {
  local target=$1
  if [[ "$target" == "--all" ]]; then
    local count
    count=$(list_profile_names | wc -l | tr -d ' ')
    (( count > 0 )) || die "No saved profiles available; save a profile first"
    return 0
  fi
  validate_profile_name "$target"
  [[ -d "$(profile_dir "$target")" ]] || die "Unknown profile '$target'"
}

cron_touch_command_label() {
  local target=$1
  if [[ "$target" == "--all" ]]; then
    printf 'codex-auth touch --all\n'
  else
    printf 'codex-auth touch %s\n' "$target"
  fi
}

cron_resolve_codex_bin() {
  local resolved
  resolved=$(command -v "$CODEX_AUTH_CODEX_BIN" 2>/dev/null || true)
  [[ -n "$resolved" ]] || die "Required command not found: $CODEX_AUTH_CODEX_BIN"
  python3 - "$resolved" <<'PY'
import os
import sys

print(os.path.abspath(sys.argv[1]))
PY
}

cron_runner_command() {
  local job_id=$1
  local target=$2
  local script_path codex_bin codex_dir codex_name cron_path command_parts=()
  script_path=$(resolve_current_executable_path "${BASH_SOURCE[0]:-$0}") || die "Unable to resolve the current executable path"
  codex_bin=$(cron_resolve_codex_bin)
  codex_dir=$(CDPATH= cd -- "$(dirname -- "$codex_bin")" && pwd -P)
  codex_name=$(basename -- "$codex_bin")
  cron_path="${CODEX_AUTH_CRON_PATH:-$codex_dir:$DEFAULT_CRON_BASE_PATH}"

  if [[ "$CODEX_HOME" != "$HOME/.codex" ]]; then
    command_parts+=("CODEX_HOME=$(shell_quote "$CODEX_HOME")")
  fi
  command_parts+=("PATH=$(shell_quote "$cron_path")")
  if [[ "$codex_name" != "codex" || "$CODEX_AUTH_CODEX_BIN" != "codex" ]]; then
    command_parts+=("CODEX_AUTH_CODEX_BIN=$(shell_quote "$codex_name")")
  fi
  command_parts+=("$(shell_quote "$script_path")")
  command_parts+=("cron")
  command_parts+=("run")
  command_parts+=("$(shell_quote "$job_id")")
  command_parts+=("$(shell_quote "$target")")

  printf '%s >> %s 2>&1\n' "${command_parts[*]}" "$(shell_quote "$CRON_LOG_FILE")"
}

cron_print_preview() {
  local job_id=$1
  local cron_expr=$2
  local schedule_description=$3
  local target=$4
  local runner_command=$5
  local touch_label
  touch_label=$(cron_touch_command_label "$target")
  note "$(style_text CODEX_AUTH_THEME_HEADER_STYLE "Cron job preview")"
  note "  $(style_text CODEX_AUTH_THEME_DIM_STYLE "ID:") $(style_text CODEX_AUTH_THEME_PROFILE_STYLE "$job_id")"
  note "  $(style_text CODEX_AUTH_THEME_DIM_STYLE "Schedule:") $(style_text CODEX_AUTH_THEME_RESET_STYLE "$schedule_description")"
  note "  $(style_text CODEX_AUTH_THEME_DIM_STYLE "Cron:") $(style_text CODEX_AUTH_THEME_ACTIVE_STYLE "$cron_expr")"
  note "  $(style_text CODEX_AUTH_THEME_DIM_STYLE "Touch command:") $(style_text CODEX_AUTH_THEME_PROFILE_STYLE "$touch_label")"
  note "  $(style_text CODEX_AUTH_THEME_DIM_STYLE "Cron command:") $runner_command"
  note "  $(style_text CODEX_AUTH_THEME_DIM_STYLE "Log:") $(style_text CODEX_AUTH_THEME_RESET_STYLE "$CRON_LOG_FILE")"
}

cron_confirm_install() {
  local reply read_status=0
  if wizard_whiptail_enabled; then
    whiptail \
      --title "codex-auth cron setup" \
      --backtitle "codex-auth" \
      --yesno "Install this cron job?" 8 60 || {
        note "Cron setup cancelled."
        return 1
      }
    return 0
  fi

  printf '%s [Y/n] ' "$(style_text CODEX_AUTH_THEME_RESET_STYLE "Install this cron job?")" >&2
  read -r reply || read_status=$?
  if [[ $read_status -ne 0 ]]; then
    note "Cron setup cancelled."
    return 1
  fi
  case "$reply" in
    ""|y|Y|yes|YES|Yes)
      return 0
      ;;
    *)
      note "Cron setup cancelled."
      return 1
      ;;
  esac
}

wizard_read_line() {
  local prompt=$1
  local default_value=${2:-}
  local reply read_status=0

  if wizard_whiptail_enabled; then
    reply=$(whiptail \
      --title "codex-auth cron setup" \
      --backtitle "codex-auth" \
      --inputbox "$prompt" 9 76 "$default_value" \
      3>&1 1>&2 2>&3) || read_status=$?
    if [[ $read_status -ne 0 ]]; then
      die "Cron setup cancelled."
    fi
    printf '%s\n' "$reply"
    return 0
  fi

  printf '%s' "$(style_text CODEX_AUTH_THEME_RESET_STYLE "$prompt")" >&2
  if [[ -n "$default_value" ]]; then
    printf ' [%s]' "$default_value" >&2
  fi
  printf ': ' >&2

  if [[ -t 0 ]]; then
    read -e -r reply || read_status=$?
  else
    read -r reply || read_status=$?
  fi

  [[ $read_status -eq 0 ]] || die "Cron setup cancelled."
  [[ -n "$reply" ]] || reply="$default_value"
  printf '%s\n' "$reply"
}

cron_install_job_locked() {
  local target=$1
  local schedule_type=$2
  local time_value=$3
  local custom_expression=$4
  local explicit_id=$5
  local assume_yes=$6

  cron_validate_target "$target"
  mkdir -p "$CRON_DIR"

  local crontab_file new_crontab_file cron_expr schedule_description base_id job_id runner_command
  crontab_file=$(mktemp)
  new_crontab_file=$(mktemp)
  cron_read_current > "$crontab_file"

  if [[ "$schedule_type" == "custom" ]]; then
    validate_cron_expression "$custom_expression" || die "Invalid custom cron expression '$custom_expression' (expected five fields)"
    cron_expr="$custom_expression"
  else
    cron_expr=$(cron_expr_from_time "$schedule_type" "$time_value")
  fi
  schedule_description=$(cron_schedule_description "$schedule_type" "$time_value" "$cron_expr")

  if [[ -n "$explicit_id" ]]; then
    validate_cron_job_id "$explicit_id"
    job_id="$explicit_id"
    if cron_has_job_id "$crontab_file" "$job_id"; then
      rm -f "$crontab_file" "$new_crontab_file"
      die "A codex-auth touch cron job with id '$job_id' already exists"
    fi
  else
    base_id=$(cron_default_job_id_base "$schedule_type" "$time_value" "$target")
    job_id=$(cron_unique_job_id "$crontab_file" "$base_id")
  fi

  runner_command=$(cron_runner_command "$job_id" "$target")
  cron_print_preview "$job_id" "$cron_expr" "$schedule_description" "$target" "$runner_command"
  if [[ "$assume_yes" != "1" ]]; then
    cron_confirm_install || {
      rm -f "$crontab_file" "$new_crontab_file"
      return 1
    }
  fi

  cp "$crontab_file" "$new_crontab_file"
  if [[ -s "$new_crontab_file" ]] && [[ "$(tail -c 1 "$new_crontab_file" 2>/dev/null || true)" != "" ]]; then
    printf '\n' >> "$new_crontab_file"
  fi
  {
    printf '# BEGIN codex-auth touch %s\n' "$job_id"
    printf '# schedule: %s\n' "$schedule_description"
    printf '# target: %s\n' "$target"
    printf '# log: %s\n' "$CRON_LOG_FILE"
    printf '%s %s\n' "$cron_expr" "$runner_command"
    printf '# END codex-auth touch %s\n' "$job_id"
  } >> "$new_crontab_file"

  cron_install_file "$new_crontab_file"
  rm -f "$crontab_file" "$new_crontab_file"
  note "Installed codex-auth touch cron job '$job_id'"
}

cron_add_command() {
  local target="--all"
  local schedule_type="daily"
  local time_value=""
  local custom_expression=""
  local explicit_id=""
  local assume_yes=0

  while [[ $# -gt 0 ]]; do
    case "$1" in
      --time)
        shift
        [[ $# -gt 0 ]] || die "Usage: codex-auth cron add --time HH:MM [--daily] [--all|--profile NAME] [--yes]"
        time_value="$1"
        ;;
      --daily)
        schedule_type="daily"
        ;;
      --schedule)
        shift
        [[ $# -gt 0 ]] || die "Usage: codex-auth cron add --schedule \"M H DOM MON DOW\" [--all|--profile NAME] [--yes]"
        schedule_type="custom"
        custom_expression="$1"
        ;;
      --all)
        target="--all"
        ;;
      --profile)
        shift
        [[ $# -gt 0 ]] || die "Usage: codex-auth cron add --profile <name>"
        target="$1"
        ;;
      --id)
        shift
        [[ $# -gt 0 ]] || die "Usage: codex-auth cron add --id <job-id>"
        explicit_id="$1"
        ;;
      --yes|-y)
        assume_yes=1
        ;;
      --help|-h)
        cron_usage
        return 0
        ;;
      *)
        die "Usage: codex-auth cron add [--time HH:MM|--schedule \"M H DOM MON DOW\"] [--daily] [--all|--profile NAME] [--id JOB] [--yes]"
        ;;
    esac
    shift
  done

  if [[ "$schedule_type" == "custom" ]]; then
    [[ -n "$custom_expression" ]] || die "Usage: codex-auth cron add --schedule \"M H DOM MON DOW\""
  else
    [[ -n "$time_value" ]] || die "Usage: codex-auth cron add --time HH:MM [--daily]"
    validate_cron_time "$time_value"
  fi

  cron_with_lock cron_install_job_locked "$target" "$schedule_type" "$time_value" "$custom_expression" "$explicit_id" "$assume_yes"
}

wizard_whiptail_enabled() {
  [[ "${CODEX_AUTH_DISABLE_WHIPTAIL:-0}" == "1" ]] && return 1
  have_cmd whiptail || return 1
  [[ "${CODEX_AUTH_FORCE_WHIPTAIL:-0}" == "1" ]] && return 0
  [[ "${TERM:-}" == "dumb" ]] && return 1
  [[ -t 0 && -t 2 ]]
}

wizard_option_field() {
  local option=$1
  local field=$2
  local label value description
  IFS=$'\t' read -r label value description <<< "$option"
  case "$field" in
    label) printf '%s\n' "$label" ;;
    value) printf '%s\n' "$value" ;;
    description) printf '%s\n' "$description" ;;
  esac
}

wizard_whiptail_select() {
  local title=$1
  local default_index=$2
  shift 2
  local -a options=("$@")
  local -a args=()
  local index label value description default_value result status=0

  default_value=$(wizard_option_field "${options[default_index]}" value)
  for index in "${!options[@]}"; do
    label=$(wizard_option_field "${options[index]}" label)
    value=$(wizard_option_field "${options[index]}" value)
    description=$(wizard_option_field "${options[index]}" description)
    args+=("$value" "$label${description:+ — $description}")
  done

  result=$(whiptail \
    --title "codex-auth cron setup" \
    --backtitle "codex-auth" \
    --default-item "$default_value" \
    --menu "$title" 15 78 "${#options[@]}" \
    "${args[@]}" \
    3>&1 1>&2 2>&3) || status=$?
  [[ $status -eq 0 ]] || die "Cron setup cancelled."
  printf '%s\n' "$result"
}

wizard_select_numbered() {
  local title=$1
  local default_index=$2
  shift 2
  local -a options=("$@")
  local reply read_status=0 index label description value

  note "$(style_text CODEX_AUTH_THEME_HEADER_STYLE "$title")"
  for index in "${!options[@]}"; do
    label=$(wizard_option_field "${options[index]}" label)
    description=$(wizard_option_field "${options[index]}" description)
    printf '  %d) %s' "$((index + 1))" "$(style_text CODEX_AUTH_THEME_PROFILE_STYLE "$label")" >&2
    if [[ -n "$description" ]]; then
      printf ' %s' "$(style_text CODEX_AUTH_THEME_DIM_STYLE "$description")" >&2
    fi
    printf '\n' >&2
  done
  printf '%s [%d]: ' "$(style_text CODEX_AUTH_THEME_RESET_STYLE "Choose")" "$((default_index + 1))" >&2
  read -r reply || read_status=$?
  [[ $read_status -eq 0 ]] || die "Cron setup cancelled."
  if [[ -z "$reply" ]]; then
    reply=$((default_index + 1))
  fi
  [[ "$reply" =~ ^[0-9]+$ ]] || die "Invalid selection"
  (( reply >= 1 && reply <= ${#options[@]} )) || die "Selection out of range"
  value=$(wizard_option_field "${options[reply-1]}" value)
  printf '%s\n' "$value"
}

wizard_select() {
  if wizard_whiptail_enabled; then
    wizard_whiptail_select "$@"
  else
    wizard_select_numbered "$@"
  fi
}

cron_prompt_target() {
  local selection
  selection=$(wizard_select \
    "Touch target" \
    0 \
    $'All profiles\tall\tRecommended; touch every saved profile' \
    $'One profile\tprofile\tChoose a saved profile')
  case "$selection" in
    all)
      printf '%s\n' "--all"
      ;;
    profile)
      choose_profile_interactive "$(find_matching_profile || true)"
      ;;
    *)
      die "Invalid target selection"
      ;;
  esac
}

cron_prompt_schedule_type() {
  wizard_select \
    "Schedule" \
    0 \
    $'Daily at a time\tdaily\tRecommended' \
    $'Custom cron expression\tcustom\tAdvanced'
}

cron_prompt_time() {
  local default_time=${1:-08:30}
  local reply
  reply=$(wizard_read_line "Run time (HH:MM, 24-hour)" "$default_time")
  validate_cron_time "$reply"
  printf '%s\n' "$reply"
}

cron_prompt_custom_expression() {
  local reply
  if ! wizard_whiptail_enabled; then
    note "$(style_text CODEX_AUTH_THEME_HEADER_STYLE "Custom cron expression")"
    note "$(style_text CODEX_AUTH_THEME_DIM_STYLE "Enter five fields: minute hour day-of-month month day-of-week")"
    note "$(style_text CODEX_AUTH_THEME_DIM_STYLE "Example: 30 8 * * 1,3,5  (Monday, Wednesday, Friday at 08:30)")"
  fi
  reply=$(wizard_read_line "Cron fields (minute hour day-of-month month day-of-week; e.g. 30 8 * * 1,3,5)" "")
  validate_cron_expression "$reply" || die "Invalid custom cron expression '$reply' (expected five fields)"
  printf '%s\n' "$reply"
}

cron_setup_command() {
  ensure_dirs
  note "$(style_text CODEX_AUTH_THEME_HEADER_STYLE "Existing codex-auth touch cron jobs")"
  cron_list_command
  note ""

  local target schedule_type time_value="" custom_expression=""
  target=$(cron_prompt_target)
  schedule_type=$(cron_prompt_schedule_type)
  if [[ "$schedule_type" == "custom" ]]; then
    custom_expression=$(cron_prompt_custom_expression)
  else
    time_value=$(cron_prompt_time "08:30")
  fi

  cron_with_lock cron_install_job_locked "$target" "$schedule_type" "$time_value" "$custom_expression" "" "0"
}

choose_cron_job_interactive() {
  local crontab_file=$1
  local entries_file use_fzf=0
  entries_file=$(mktemp)
  cron_job_tsv_from_file "$crontab_file" > "$entries_file"
  [[ $(wc -l < "$entries_file") -gt 1 ]] || die "No codex-auth touch cron jobs to delete"

  if command -v fzf >/dev/null 2>&1; then
    if [[ "${CODEX_AUTH_FORCE_FZF:-0}" == "1" ]] || [[ -t 0 ]] || [[ -r /dev/tty ]]; then
      use_fzf=1
    fi
  fi

  if [[ $use_fzf -eq 1 ]]; then
    local selected
    local -a fzf_opts
    fzf_opts=(--delimiter=$'\t' --with-nth=2 --header-lines=1 --prompt='Delete cron job> ' --layout=reverse --border)
    if [[ -n "${TMUX:-}" ]] && ( [[ -t 0 ]] || [[ -r /dev/tty ]] ) && command -v fzf-tmux >/dev/null 2>&1; then
      selected=$(fzf-tmux -p 80%,70% "${fzf_opts[@]}" < "$entries_file" || true)
    else
      fzf_opts+=(--height=80%)
      selected=$(fzf "${fzf_opts[@]}" < "$entries_file" || true)
    fi
    [[ -n "$selected" ]] || die "No cron job selected"
    rm -f "$entries_file"
    printf '%s\n' "$selected" | cut -f1
    return 0
  fi

  local options=() i=1 choice display job_id
  echo "Select a cron job to delete:" >&2
  while IFS=$'\t' read -r job_id display; do
    [[ "$job_id" == "ID" ]] && continue
    options+=("$job_id")
    printf '  %d) %s\n' "$i" "$display" >&2
    i=$((i + 1))
  done < "$entries_file"
  read -r -p 'Enter number: ' choice
  [[ "$choice" =~ ^[0-9]+$ ]] || die "Invalid selection"
  (( choice >= 1 && choice <= ${#options[@]} )) || die "Selection out of range"
  rm -f "$entries_file"
  printf '%s\n' "${options[choice-1]}"
}

cron_confirm_delete() {
  local description=$1
  local reply read_status=0
  printf 'Delete %s? [y/N] ' "$description" >&2
  read -r reply || read_status=$?
  [[ $read_status -eq 0 ]] || return 1
  case "$reply" in
    y|Y|yes|YES|Yes)
      return 0
      ;;
    *)
      note "Cron delete cancelled."
      return 1
      ;;
  esac
}

cron_delete_jobs_locked() {
  local delete_all=$1
  shift
  local -a ids=("$@")
  local crontab_file new_crontab_file deleted_file
  crontab_file=$(mktemp)
  new_crontab_file=$(mktemp)
  deleted_file=$(mktemp)
  cron_read_current > "$crontab_file"

  python3 - "$crontab_file" "$new_crontab_file" "$deleted_file" "$delete_all" "${ids[@]}" <<'PY'
import re
import sys
from pathlib import Path

in_path = Path(sys.argv[1])
out_path = Path(sys.argv[2])
deleted_path = Path(sys.argv[3])
delete_all = sys.argv[4] == '1'
ids = set(sys.argv[5:])

lines = in_path.read_text(encoding='utf-8').splitlines() if in_path.exists() else []
out = []
deleted = []
i = 0
while i < len(lines):
    line = lines[i]
    match = re.match(r'^# BEGIN codex-auth touch ([A-Za-z0-9._-]+)\s*$', line)
    if not match:
        out.append(line)
        i += 1
        continue

    job_id = match.group(1)
    block = [line]
    i += 1
    complete = False
    while i < len(lines):
        block.append(lines[i])
        if re.match(rf'^# END codex-auth touch {re.escape(job_id)}\s*$', lines[i]):
            complete = True
            i += 1
            break
        i += 1

    if complete and (delete_all or job_id in ids):
        deleted.append(job_id)
    else:
        out.extend(block)

out_path.write_text('\n'.join(out) + ('\n' if out else ''), encoding='utf-8')
deleted_path.write_text('\n'.join(deleted) + ('\n' if deleted else ''), encoding='utf-8')
PY

  if [[ ! -s "$deleted_file" ]]; then
    rm -f "$crontab_file" "$new_crontab_file" "$deleted_file"
    if [[ "$delete_all" == "1" ]]; then
      die "No codex-auth touch cron jobs to delete"
    fi
    die "No matching codex-auth touch cron job found"
  fi

  cron_install_file "$new_crontab_file"
  local deleted_id
  while IFS= read -r deleted_id; do
    [[ -n "$deleted_id" ]] || continue
    note "Deleted codex-auth touch cron job '$deleted_id'"
  done < "$deleted_file"
  rm -f "$crontab_file" "$new_crontab_file" "$deleted_file"
}

cron_delete_command() {
  local target=""
  local assume_yes=0
  local delete_all=0
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --all)
        [[ -z "$target" ]] || die "Usage: codex-auth cron delete [<job-id>|--all] [--yes]"
        delete_all=1
        target="--all"
        ;;
      --yes|-y)
        assume_yes=1
        ;;
      --help|-h)
        cron_usage
        return 0
        ;;
      -*)
        die "Usage: codex-auth cron delete [<job-id>|--all] [--yes]"
        ;;
      *)
        [[ -z "$target" ]] || die "Usage: codex-auth cron delete [<job-id>|--all] [--yes]"
        target="$1"
        ;;
    esac
    shift
  done

  local crontab_file
  crontab_file=$(mktemp)
  cron_read_current > "$crontab_file"
  if [[ -z "$target" ]]; then
    target=$(choose_cron_job_interactive "$crontab_file")
  fi

  if [[ "$delete_all" -eq 1 ]]; then
    if [[ "$assume_yes" -ne 1 ]]; then
      cron_confirm_delete "all codex-auth touch cron jobs" || {
        rm -f "$crontab_file"
        return 1
      }
    fi
    rm -f "$crontab_file"
    cron_with_lock cron_delete_jobs_locked 1
    return $?
  fi

  validate_cron_job_id "$target"
  if [[ "$assume_yes" -ne 1 ]]; then
    cron_confirm_delete "codex-auth touch cron job '$target'" || {
      rm -f "$crontab_file"
      return 1
    }
  fi
  rm -f "$crontab_file"
  cron_with_lock cron_delete_jobs_locked 0 "$target"
}

cron_run_command() {
  local job_id=${1:-}
  local target=${2:-}
  [[ -n "$job_id" && -n "$target" ]] || die "Usage: codex-auth cron run <job-id> <profile|--all>"
  validate_cron_job_id "$job_id"
  cron_validate_target "$target"
  mkdir -p "$CRON_DIR"

  local touch_label status=0 started_at ended_at
  touch_label=$(cron_touch_command_label "$target")
  started_at=$(date '+%Y-%m-%dT%H:%M:%S%z')
  printf '[%s] START %s (job=%s)\n' "$started_at" "$touch_label" "$job_id"
  if touch_command "$target"; then
    status=0
  else
    status=$?
  fi
  ended_at=$(date '+%Y-%m-%dT%H:%M:%S%z')
  printf '[%s] END %s (job=%s status=%s)\n' "$ended_at" "$touch_label" "$job_id" "$status"
  return "$status"
}

cron_command() {
  local subcmd=${1:-list}
  case "$subcmd" in
    list)
      shift || true
      [[ $# -eq 0 ]] || die "Usage: codex-auth cron list"
      cron_list_command
      ;;
    setup|wizard)
      shift || true
      [[ $# -eq 0 ]] || die "Usage: codex-auth cron setup"
      cron_setup_command
      ;;
    add)
      shift || true
      cron_add_command "$@"
      ;;
    delete|remove|rm)
      shift || true
      cron_delete_command "$@"
      ;;
    run)
      shift || true
      [[ $# -eq 2 ]] || die "Usage: codex-auth cron run <job-id> <profile|--all>"
      cron_run_command "$1" "$2"
      ;;
    help|-h|--help)
      cron_usage
      ;;
    *)
      die "Unknown cron command '$subcmd' (run 'codex-auth cron help')"
      ;;
  esac
}

update_self() {
  require_cmd python3
  require_cmd curl

  local from_base installer_url script_path bin_dir parent_dir completion_dir installer_path
  local -a installer_args

  from_base="${CODEX_AUTH_INSTALL_FROM:-$DEFAULT_INSTALL_FROM_BASE}"
  from_base=${from_base%/}
  installer_url="$from_base/install.sh"

  script_path=$(resolve_current_executable_path "${BASH_SOURCE[0]:-$0}") || die "Unable to resolve the current executable path"
  bin_dir=$(CDPATH= cd -- "$(dirname -- "$script_path")" && pwd -P)
  parent_dir=$(CDPATH= cd -- "$bin_dir/.." && pwd -P)

  if [[ -f "$parent_dir/install.sh" && -f "$parent_dir/bin/codex-auth" && -f "$parent_dir/completions/codex-auth.bash" ]]; then
    die "codex-auth update is for installed copies; in a local checkout, run ./install.sh instead"
  fi

  installer_args=(--bin-dir "$bin_dir")

  if [[ "$(basename -- "$bin_dir")" == "bin" ]]; then
    completion_dir="$parent_dir/share/bash-completion/completions"
    if [[ -f "$completion_dir/codex-auth" ]]; then
      installer_args+=(--completion-dir "$completion_dir")
    else
      installer_args+=(--skip-completions)
    fi
  else
    installer_args+=(--skip-completions)
  fi

  installer_path=$(mktemp "${TMPDIR:-/tmp}/codex-auth-install.XXXXXX") || die "Failed to allocate a temporary installer path"
  if ! curl -fsSL "$installer_url" -o "$installer_path"; then
    rm -f "$installer_path"
    die "Failed to download installer from $installer_url"
  fi

  note "Updating codex-auth from $from_base"
  if bash "$installer_path" "${installer_args[@]}"; then
    rm -f "$installer_path"
  else
    local status=$?
    rm -f "$installer_path"
    return "$status"
  fi
}

main() {
  local cmd=${1:-help}
  case "$cmd" in
    help|-h|--help)
      usage
      ;;
    list)
      shift
      local list_use_utc=0
      local list_include_stats=0
      while [[ $# -gt 0 ]]; do
        case "$1" in
          --utc)
            [[ $list_use_utc -eq 0 ]] || die "Usage: codex-auth list [--utc] [--with-stats]"
            list_use_utc=1
            ;;
          --with-stats)
            [[ $list_include_stats -eq 0 ]] || die "Usage: codex-auth list [--utc] [--with-stats]"
            list_include_stats=1
            ;;
          *)
            die "Usage: codex-auth list [--utc] [--with-stats]"
            ;;
        esac
        shift
      done
      list_profiles "$list_use_utc" "$list_include_stats"
      ;;
    current)
      shift
      case "${1:-}" in
        "")
          show_current 0
          ;;
        --utc)
          [[ $# -eq 1 ]] || die "Usage: codex-auth current [--utc]"
          show_current 1
          ;;
        *)
          die "Usage: codex-auth current [--utc]"
          ;;
      esac
      ;;
    save)
      shift
      [[ $# -eq 1 ]] || die "Usage: codex-auth save <name>"
      save_profile "$1"
      ;;
    switch)
      shift
      [[ $# -le 1 ]] || die "Usage: codex-auth switch [name]"
      switch_profile "${1:-}"
      ;;
    add)
      shift
      [[ $# -eq 1 ]] || die "Usage: codex-auth add <name>"
      add_profile "$1"
      ;;
    stats|statistics)
      shift
      stats_command "$@"
      ;;
    refresh-usage|refresh)
      shift
      local refresh_target=""
      local refresh_use_utc=0
      local refresh_include_stats=0
      while [[ $# -gt 0 ]]; do
        case "$1" in
          --utc)
            [[ $refresh_use_utc -eq 0 ]] || die "Usage: codex-auth refresh-usage [--utc] [--with-stats] [<name>|--all]"
            refresh_use_utc=1
            ;;
          --with-stats)
            [[ $refresh_include_stats -eq 0 ]] || die "Usage: codex-auth refresh-usage [--utc] [--with-stats] [<name>|--all]"
            refresh_include_stats=1
            ;;
          --all)
            [[ -z "$refresh_target" ]] || die "Usage: codex-auth refresh-usage [--utc] [--with-stats] [<name>|--all]"
            refresh_target="--all"
            ;;
          -*)
            die "Usage: codex-auth refresh-usage [--utc] [--with-stats] [<name>|--all]"
            ;;
          *)
            [[ -z "$refresh_target" ]] || die "Usage: codex-auth refresh-usage [--utc] [--with-stats] [<name>|--all]"
            refresh_target="$1"
            ;;
        esac
        shift
      done
      refresh_usage_command "$refresh_target" "$refresh_use_utc" "$refresh_include_stats"
      ;;
    token-status)
      shift
      local token_status_target=""
      local token_status_use_utc=0
      while [[ $# -gt 0 ]]; do
        case "$1" in
          --utc)
            [[ $token_status_use_utc -eq 0 ]] || die "Usage: codex-auth token-status [--utc] [<name>|--all]"
            token_status_use_utc=1
            ;;
          --all)
            [[ -z "$token_status_target" ]] || die "Usage: codex-auth token-status [--utc] [<name>|--all]"
            token_status_target="--all"
            ;;
          -*)
            die "Usage: codex-auth token-status [--utc] [<name>|--all]"
            ;;
          *)
            [[ -z "$token_status_target" ]] || die "Usage: codex-auth token-status [--utc] [<name>|--all]"
            token_status_target="$1"
            ;;
        esac
        shift
      done
      token_status_command "$token_status_target" "$token_status_use_utc"
      ;;
    touch)
      shift
      [[ $# -eq 1 ]] || die "Usage: codex-auth touch <name>|--all"
      touch_command "$1"
      ;;
    cron)
      shift
      cron_command "$@"
      ;;
    update)
      shift
      [[ $# -eq 0 ]] || die "Usage: codex-auth update"
      update_self
      ;;
    rename)
      shift
      [[ $# -eq 2 ]] || die "Usage: codex-auth rename <old> <new>"
      rename_profile "$1" "$2"
      ;;
    remove|rm|delete)
      shift
      [[ $# -eq 1 ]] || die "Usage: codex-auth remove <name>"
      remove_profile "$1"
      ;;
    version|-v|--version)
      shift
      [[ $# -eq 0 ]] || die "Usage: codex-auth version"
      print_version
      ;;
    *)
      die "Unknown command '$cmd' (run 'codex-auth help')"
      ;;
  esac
}

main "$@"
